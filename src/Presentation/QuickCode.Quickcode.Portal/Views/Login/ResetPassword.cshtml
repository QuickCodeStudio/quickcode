@model ResetPasswordData
@{
    ViewData["Title"] = "Reset password";
    var queryCollection = Context.Request.Query;
    var routeData = new Dictionary<string, string>(queryCollection.Select(x => new KeyValuePair<string, string>(x.Key, x.Value!)));
    var openedFromEmail = !string.IsNullOrEmpty(Model.ResetCode);
}

<section class="auth-card">
    <div class="auth-card__inner">
        <p class="auth-card__eyebrow">Account recovery</p>
        <h1 class="auth-card__title">Choose a new password</h1>
        @if (openedFromEmail)
        {
            <p class="auth-card__lead">Set a password you’ll remember. The reset link already identified your account.</p>
        }
        else
        {
            <p class="auth-card__lead">Open the reset link in your email. If you don’t have one yet, request a new link.</p>
        }

        @if (openedFromEmail || !string.IsNullOrEmpty(Model.SuccessMessage) || !string.IsNullOrEmpty(Model.ErrorMessage))
        {
        <form class="auth-form" asp-action="ResetPassword" asp-all-route-data="routeData" autocomplete="off" novalidate>
            <div class="auth-field">
                <label class="auth-field__label" asp-for="Email">Email</label>
                <input asp-for="Email"
                       class="auth-field__input"
                       type="email"
                       autocomplete="email"
                       inputmode="email"
                       placeholder="name@company.com"
                       readonly="@openedFromEmail"
                       aria-required="true" />
                <span asp-validation-for="Email" class="auth-field__hint"></span>
            </div>

            <input type="hidden" asp-for="ResetCode" />

            <div class="auth-field">
                <label class="auth-field__label" asp-for="NewPassword">New password</label>
                <div class="auth-password">
                    <input asp-for="NewPassword"
                           id="reset-password"
                           class="auth-field__input"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Uppercase, lowercase, number, and symbol"
                           aria-required="true" />
                    <button type="button"
                            class="auth-password__toggle"
                            data-auth-password-toggle
                            aria-controls="reset-password"
                            aria-pressed="false"
                            aria-label="Show password">
                        <i class="far fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <p class="auth-field__hint">At least 8 characters, with uppercase, lowercase, a number, and a symbol.</p>
                <span asp-validation-for="NewPassword" class="auth-field__hint"></span>
            </div>

            <div class="auth-field">
                <label class="auth-field__label" asp-for="ConfirmPassword">Confirm password</label>
                <div class="auth-password">
                    <input asp-for="ConfirmPassword"
                           id="reset-confirm-password"
                           class="auth-field__input"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Re-enter password"
                           aria-required="true" />
                    <button type="button"
                            class="auth-password__toggle"
                            data-auth-password-toggle
                            aria-controls="reset-confirm-password"
                            aria-pressed="false"
                            aria-label="Show password">
                        <i class="far fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="auth-field__hint"></span>
            </div>

            <button type="submit" class="auth-btn">Update password</button>

            <div class="auth-alert" data-auth-alert hidden role="alert"></div>
        </form>
        }

        <div class="auth-footer">
            <a class="auth-link" asp-action="Index" asp-controller="Login">Back to sign in</a>
            <a class="auth-link" asp-action="ForgotPassword" asp-controller="Login">Request a new reset link</a>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
