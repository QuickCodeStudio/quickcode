@model QuickCode.Quickcode.Portal.Models.QuickcodeModule.ProjectGetProjectByRequestData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    if (startIndex < 1) { startIndex = 1; }
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData()
    {
        CurrentPage = Model.CurrentPage,
        NumberOfRecord = Model.NumberOfRecord,
        PageSize = Model.PageSize,
        TotalPage = Model.TotalPage,
        StartIndex = startIndex,
        EndIndex = endIndex,
        HasMoreRecords = Model.HasMoreRecords,
        RecordNounSingular = "row",
        RecordNounPlural = "rows"
    };
    var resultCount = Model.List?.Count ?? 0;
    var hasPager = false;
}
@* Always present so Endpoint modal can show Response fields before the report is run. *@
<script type="application/json" id="portalQueryResponseSchema" data-response-type="GetProjectByRequestResponseDto">[{"name":"id","type":"Guid","description":"ID \u2014 field on the response DTO."},{"name":"key","type":"string","description":"Key \u2014 field on the response DTO."},{"name":"name","type":"string","description":"Name \u2014 field on the response DTO."},{"name":"email","type":"string","description":"Email \u2014 field on the response DTO."},{"name":"generationStatusId","type":"int","description":"Generation Status ID \u2014 field on the response DTO."},{"name":"secretCode","type":"string","description":"Secret Code \u2014 field on the response DTO."},{"name":"description","type":"string","description":"Description \u2014 field on the response DTO."},{"name":"isActive","type":"bool","description":"Is Active \u2014 field on the response DTO."},{"name":"createdDate","type":"DateTime","description":"Created Date \u2014 field on the response DTO."},{"name":"updatedDate","type":"DateTime","description":"Updated Date \u2014 field on the response DTO."},{"name":"requestId","type":"Guid","description":"Request ID \u2014 field on the response DTO."},{"name":"requestStatus","type":"ProjectRequestStatus","description":"Request Status \u2014 field on the response DTO."},{"name":"requestEmail","type":"string","description":"Request Email \u2014 field on the response DTO."}]</script>
@if (!Model.HasRun)
{
    <div class="portal-query-empty portal-query-empty--idle" role="status">
        <span class="portal-query-empty__title">Ready to run</span>
        <span class="portal-query-empty__text">Choose parameters, then hit <strong>Run Report</strong>.</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    var isNotFound = Model.QueryHttpStatus == 404;
    var emptyClass = isNotFound ? "portal-query-empty--empty" : "portal-query-empty--error";
    var title = isNotFound ? "No rows matched" : "Request failed";
    <div class="portal-query-empty @emptyClass" role="@(isNotFound ? "status" : "alert")">
        <div class="portal-query-empty__header">
            <span class="portal-query-empty__title">@title</span>
            @if (Model.QueryHttpStatus.HasValue)
            {
                <span class="portal-query-empty__status">HTTP @Model.QueryHttpStatus</span>
            }
        </div>
        <span class="portal-query-empty__text">@Model.ErrorMessage</span>
    </div>
}
else if (Model.List == null || Model.List.Count == 0)
{
    <div class="portal-query-empty portal-query-empty--empty" role="status">
        <span class="portal-query-empty__title">No rows matched</span>
        <span class="portal-query-empty__text">Nothing came back for the current parameters.</span>
    </div>
}
else
{

@if (!hasPager)
{
    <div class="portal-list-pager">
        <div class="portal-list-pager__cluster">
            <div class="portal-list-pager__range" aria-live="polite">
                <span class="portal-list-pager__range-strong">@resultCount.ToString("N0")</span>
                <span class="portal-list-pager__range-muted">@(resultCount == 1 ? "row" : "rows")</span>
            </div>
        </div>
    </div>
}
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    <th class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">#</th>
                                        <th class="portal-col" data-col-type="guid" data-col-key="Id">ID</th>
                    <th class="portal-col" data-col-type="text" data-col-key="Key">Key</th>
                    <th class="portal-col" data-col-type="text" data-col-key="Name">Name</th>
                    <th class="portal-col" data-col-type="email" data-col-key="Email">Email</th>
                    <th class="portal-col" data-col-type="int" data-col-key="GenerationStatusId">Generation Status ID</th>
                    <th class="portal-col" data-col-type="text" data-col-key="SecretCode">Secret Code</th>
                    <th class="portal-col" data-col-type="large" data-col-key="Description">Description</th>
                    <th class="portal-col" data-col-type="bool" data-col-key="IsActive">Is Active</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">Created Date</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="UpdatedDate">Updated Date</th>
                    <th class="portal-col" data-col-type="guid" data-col-key="RequestId">Request ID</th>
                    <th class="portal-col" data-col-type="text" data-col-key="RequestStatus">Request Status</th>
                    <th class="portal-col" data-col-type="email" data-col-key="RequestEmail">Request Email</th>
                </tr>
            </thead>
            <tbody>
@{
    var rowNo = startIndex;
}
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">@rowNo</td>
                                                <td class="portal-col" data-col-type="guid" data-col-key="Id">@item.Id</td>
                        <td class="portal-col" data-col-type="text" data-col-key="Key">@item.Key</td>
                        <td class="portal-col" data-col-type="text" data-col-key="Name">@item.Name</td>
                        <td class="portal-col" data-col-type="email" data-col-key="Email">@item.Email</td>
                        <td class="portal-col" data-col-type="int" data-col-key="GenerationStatusId">@(((object)item.GenerationStatusId).ToPortalGridInt())</td>
                        <td class="portal-col" data-col-type="text" data-col-key="SecretCode">@item.SecretCode</td>
                        <td class="portal-col" data-col-type="large" data-col-key="Description">@item.Description</td>
                        <td class="portal-col" data-col-type="bool" data-col-key="IsActive">@item.IsActive</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">@(((object)item.CreatedDate).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="UpdatedDate">@(((object)item.UpdatedDate).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="guid" data-col-key="RequestId">@item.RequestId</td>
                        <td class="portal-col" data-col-type="text" data-col-key="RequestStatus">@item.RequestStatus</td>
                        <td class="portal-col" data-col-type="email" data-col-key="RequestEmail">@item.RequestEmail</td>
                    </tr>
                    rowNo++;
                }
            </tbody>
        </table>
    </div>
}
