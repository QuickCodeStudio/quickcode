@using QuickCode.Quickcode.Portal.Models.QuickcodeModule
@using QuickCode.Quickcode.Portal.Helpers
@inject IPortalPagePermissionManager PortalPagePermissions
@model QuickcodeModule.PageConfigData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex };
    var areaName = ViewContext.RouteData.Values["Area"]?.ToString() ?? string.Empty;
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;
    var actionName = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
    var ops = await PortalPagePermissions.GetPagePermission($"{areaName}{controllerName}", actionName);
}
@if (Model.List.Count == 0)
{
    <div class="alert alert-danger" role="alert">
        No Data available in QuickcodeModule.PageConfig table.
    </div>
}
else
{
    <vc:pager pager-data=pagerData></vc:pager>
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    @PortalOperationButtonsHtml.Cell(ops, "Header", areaName, controllerName)
                    <th class="portal-col" data-col-type="text" data-col-key="PageKey">Page Key</th>
<th class="portal-col" data-col-type="bool" data-col-key="IsActive">Is Active</th>
<th class="portal-col" data-col-type="large" data-col-key="PageConfigData">Page Config Data</th>
<th class="portal-col" data-col-type="text" data-col-key="PageTitle">Page Title</th>
<th class="portal-col" data-col-type="int" data-col-key="PageType">Page Type</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        @PortalOperationButtonsHtml.Cell(ops, item.GetKey(), areaName, controllerName)
                        <td class="portal-col" data-col-type="text" data-col-key="PageKey">@item.PageKey</td>
<td class="portal-col" data-col-type="bool" data-col-key="IsActive">@if (item.IsActive == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsActive" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsActive" disabled />
    </div>
}
</td>
<td class="portal-col" data-col-type="large" data-col-key="PageConfigData">@item.PageConfigData</td>
<td class="portal-col" data-col-type="text" data-col-key="PageTitle">@item.PageTitle</td>
<td class="portal-col" data-col-type="int" data-col-key="PageType">@(((object)item.PageType).ToPortalGridInt())</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
}
