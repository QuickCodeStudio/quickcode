@model QuickCode.Quickcode.Portal.Models.QuickcodeModule.GenerationActionGetIdBetweenData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    if (startIndex < 1) { startIndex = 1; }
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData()
    {
        CurrentPage = Model.CurrentPage,
        NumberOfRecord = Model.NumberOfRecord,
        PageSize = Model.PageSize,
        TotalPage = Model.TotalPage,
        StartIndex = startIndex,
        EndIndex = endIndex,
        HasMoreRecords = Model.HasMoreRecords,
        RecordNounSingular = "row",
        RecordNounPlural = "rows"
    };
    var resultCount = Model.List?.Count ?? 0;
    var hasPager = false;
}
@* Always present so Endpoint modal can show Response fields before the report is run. *@
<script type="application/json" id="portalQueryResponseSchema" data-response-type="List<GetIdBetweenResponseDto>">[{"name":"id","type":"int","description":"ID \u2014 field on the response DTO."},{"name":"projectId","type":"Guid","description":"Project ID \u2014 field on the response DTO."},{"name":"generationRunId","type":"int","description":"Generation Run ID \u2014 field on the response DTO."},{"name":"generationStepId","type":"int","description":"Generation Step ID \u2014 field on the response DTO."},{"name":"stepParameters","type":"string","description":"Step Parameters \u2014 field on the response DTO."},{"name":"createdDate","type":"DateTime","description":"Created Date \u2014 field on the response DTO."},{"name":"startDate","type":"DateTime","description":"Start Date \u2014 field on the response DTO."},{"name":"endDate","type":"DateTime","description":"End Date \u2014 field on the response DTO."},{"name":"elapsedTime","type":"int","description":"Elapsed Time \u2014 field on the response DTO."},{"name":"outputMessage","type":"string","description":"Output Message \u2014 field on the response DTO."},{"name":"isCompleted","type":"bool","description":"Is Completed \u2014 field on the response DTO."}]</script>
@if (!Model.HasRun)
{
    <div class="portal-query-empty portal-query-empty--idle" role="status">
        <span class="portal-query-empty__title">Ready to run</span>
        <span class="portal-query-empty__text">Choose parameters, then hit <strong>Run Report</strong>.</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    var isNotFound = Model.QueryHttpStatus == 404;
    var emptyClass = isNotFound ? "portal-query-empty--empty" : "portal-query-empty--error";
    var title = isNotFound ? "No rows matched" : "Request failed";
    <div class="portal-query-empty @emptyClass" role="@(isNotFound ? "status" : "alert")">
        <div class="portal-query-empty__header">
            <span class="portal-query-empty__title">@title</span>
            @if (Model.QueryHttpStatus.HasValue)
            {
                <span class="portal-query-empty__status">HTTP @Model.QueryHttpStatus</span>
            }
        </div>
        <span class="portal-query-empty__text">@Model.ErrorMessage</span>
    </div>
}
else if (Model.List == null || Model.List.Count == 0)
{
    <div class="portal-query-empty portal-query-empty--empty" role="status">
        <span class="portal-query-empty__title">No rows matched</span>
        <span class="portal-query-empty__text">Nothing came back for the current parameters.</span>
    </div>
}
else
{

@if (!hasPager)
{
    <div class="portal-list-pager">
        <div class="portal-list-pager__cluster">
            <div class="portal-list-pager__range" aria-live="polite">
                <span class="portal-list-pager__range-strong">@resultCount.ToString("N0")</span>
                <span class="portal-list-pager__range-muted">@(resultCount == 1 ? "row" : "rows")</span>
            </div>
        </div>
    </div>
}
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    <th class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">#</th>
                                        <th class="portal-col" data-col-type="int" data-col-key="Id">ID</th>
                    <th class="portal-col" data-col-type="guid" data-col-key="ProjectId">Project ID</th>
                    <th class="portal-col" data-col-type="int" data-col-key="GenerationRunId">Generation Run ID</th>
                    <th class="portal-col" data-col-type="int" data-col-key="GenerationStepId">Generation Step ID</th>
                    <th class="portal-col" data-col-type="large" data-col-key="StepParameters">Step Parameters</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">Created Date</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="StartDate">Start Date</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="EndDate">End Date</th>
                    <th class="portal-col" data-col-type="int" data-col-key="ElapsedTime">Elapsed Time</th>
                    <th class="portal-col" data-col-type="large" data-col-key="OutputMessage">Output Message</th>
                    <th class="portal-col" data-col-type="bool" data-col-key="IsCompleted">Is Completed</th>
                </tr>
            </thead>
            <tbody>
@{
    var rowNo = startIndex;
}
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">@rowNo</td>
                                                <td class="portal-col" data-col-type="int" data-col-key="Id">@(((object)item.Id).ToPortalGridInt())</td>
                        <td class="portal-col" data-col-type="guid" data-col-key="ProjectId">@item.ProjectId</td>
                        <td class="portal-col" data-col-type="int" data-col-key="GenerationRunId">@(((object)item.GenerationRunId).ToPortalGridInt())</td>
                        <td class="portal-col" data-col-type="int" data-col-key="GenerationStepId">@(((object)item.GenerationStepId).ToPortalGridInt())</td>
                        <td class="portal-col" data-col-type="large" data-col-key="StepParameters">@item.StepParameters</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">@(((object)item.CreatedDate).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="StartDate">@(((object)item.StartDate).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="EndDate">@(((object)item.EndDate).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="int" data-col-key="ElapsedTime">@(((object)item.ElapsedTime).ToPortalGridInt())</td>
                        <td class="portal-col" data-col-type="large" data-col-key="OutputMessage">@item.OutputMessage</td>
                        <td class="portal-col" data-col-type="bool" data-col-key="IsCompleted">@item.IsCompleted</td>
                    </tr>
                    rowNo++;
                }
            </tbody>
        </table>
    </div>
}
