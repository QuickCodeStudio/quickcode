@model QuickCode.Quickcode.Portal.Models.IdentityModule.ApiKeyGetByStatusData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    if (startIndex < 1) { startIndex = 1; }
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData()
    {
        CurrentPage = Model.CurrentPage,
        NumberOfRecord = Model.NumberOfRecord,
        PageSize = Model.PageSize,
        TotalPage = Model.TotalPage,
        StartIndex = startIndex,
        EndIndex = endIndex,
        HasMoreRecords = Model.HasMoreRecords,
        RecordNounSingular = "row",
        RecordNounPlural = "rows"
    };
    var resultCount = Model.List?.Count ?? 0;
    var hasPager = true;
}
@* Always present so Endpoint modal can show Response fields before the report is run. *@
<script type="application/json" id="portalQueryResponseSchema" data-response-type="List<GetByStatusResponseDto>">[{"name":"id","type":"Guid","description":"ID \u2014 field on the response DTO."},{"name":"name","type":"string","description":"Name \u2014 field on the response DTO."},{"name":"description","type":"string","description":"Description \u2014 field on the response DTO."},{"name":"keyPrefix","type":"string","description":"Key Prefix \u2014 field on the response DTO."},{"name":"keyHash","type":"string","description":"Key Hash \u2014 field on the response DTO."},{"name":"permissionGroupName","type":"string","description":"Permission Group Name \u2014 field on the response DTO."},{"name":"createdByUserId","type":"string","description":"Created By User ID \u2014 field on the response DTO."},{"name":"status","type":"ApiKeyStatus","description":"Status \u2014 field on the response DTO."},{"name":"isActive","type":"bool","description":"Is Active \u2014 field on the response DTO."},{"name":"expiresAt","type":"DateTime","description":"Expires At \u2014 field on the response DTO."},{"name":"lastUsedAt","type":"DateTime","description":"Last Used At \u2014 field on the response DTO."},{"name":"createdDate","type":"DateTime","description":"Created Date \u2014 field on the response DTO."},{"name":"revokedDate","type":"DateTime","description":"Revoked Date \u2014 field on the response DTO."}]</script>
@if (!Model.HasRun)
{
    <div class="portal-query-empty portal-query-empty--idle" role="status">
        <span class="portal-query-empty__title">Ready to run</span>
        <span class="portal-query-empty__text">Choose parameters, then hit <strong>Run Report</strong>.</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    var isNotFound = Model.QueryHttpStatus == 404;
    var emptyClass = isNotFound ? "portal-query-empty--empty" : "portal-query-empty--error";
    var title = isNotFound ? "No rows matched" : "Request failed";
    <div class="portal-query-empty @emptyClass" role="@(isNotFound ? "status" : "alert")">
        <div class="portal-query-empty__header">
            <span class="portal-query-empty__title">@title</span>
            @if (Model.QueryHttpStatus.HasValue)
            {
                <span class="portal-query-empty__status">HTTP @Model.QueryHttpStatus</span>
            }
        </div>
        <span class="portal-query-empty__text">@Model.ErrorMessage</span>
    </div>
}
else if (Model.List == null || Model.List.Count == 0)
{
    <div class="portal-query-empty portal-query-empty--empty" role="status">
        <span class="portal-query-empty__title">No rows matched</span>
        <span class="portal-query-empty__text">Nothing came back for the current parameters.</span>
    </div>
}
else
{
    <vc:pager pager-data=pagerData></vc:pager>
@if (!hasPager)
{
    <div class="portal-list-pager">
        <div class="portal-list-pager__cluster">
            <div class="portal-list-pager__range" aria-live="polite">
                <span class="portal-list-pager__range-strong">@resultCount.ToString("N0")</span>
                <span class="portal-list-pager__range-muted">@(resultCount == 1 ? "row" : "rows")</span>
            </div>
        </div>
    </div>
}
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    <th class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">#</th>
                                        <th class="portal-col" data-col-type="guid" data-col-key="Id">ID</th>
                    <th class="portal-col" data-col-type="text" data-col-key="Name">Name</th>
                    <th class="portal-col" data-col-type="text" data-col-key="Description">Description</th>
                    <th class="portal-col" data-col-type="text" data-col-key="KeyPrefix">Key Prefix</th>
                    <th class="portal-col" data-col-type="text" data-col-key="KeyHash">Key Hash</th>
                    <th class="portal-col" data-col-type="text" data-col-key="PermissionGroupName">Permission Group Name</th>
                    <th class="portal-col" data-col-type="text" data-col-key="CreatedByUserId">Created By User ID</th>
                    <th class="portal-col" data-col-type="text" data-col-key="Status">Status</th>
                    <th class="portal-col" data-col-type="bool" data-col-key="IsActive">Is Active</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="ExpiresAt">Expires At</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="LastUsedAt">Last Used At</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">Created Date</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="RevokedDate">Revoked Date</th>
                </tr>
            </thead>
            <tbody>
@{
    var rowNo = startIndex;
}
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">@rowNo</td>
                                                <td class="portal-col" data-col-type="guid" data-col-key="Id">@item.Id</td>
                        <td class="portal-col" data-col-type="text" data-col-key="Name">@item.Name</td>
                        <td class="portal-col" data-col-type="text" data-col-key="Description">@item.Description</td>
                        <td class="portal-col" data-col-type="text" data-col-key="KeyPrefix">@item.KeyPrefix</td>
                        <td class="portal-col" data-col-type="text" data-col-key="KeyHash">@item.KeyHash</td>
                        <td class="portal-col" data-col-type="text" data-col-key="PermissionGroupName">@item.PermissionGroupName</td>
                        <td class="portal-col" data-col-type="text" data-col-key="CreatedByUserId">@item.CreatedByUserId</td>
                        <td class="portal-col" data-col-type="text" data-col-key="Status">@item.Status</td>
                        <td class="portal-col" data-col-type="bool" data-col-key="IsActive">@item.IsActive</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="ExpiresAt">@(((object)item.ExpiresAt).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="LastUsedAt">@(((object)item.LastUsedAt).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">@(((object)item.CreatedDate).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="RevokedDate">@(((object)item.RevokedDate).ToPortalGridDateTime())</td>
                    </tr>
                    rowNo++;
                }
            </tbody>
        </table>
    </div>
}
