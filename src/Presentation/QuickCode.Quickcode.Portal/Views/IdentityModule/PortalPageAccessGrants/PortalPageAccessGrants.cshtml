@model GetPortalPageAccessGrantData
@using System.Collections.Generic
@using System.Linq
@{
string title = "Portal Page Access Grant Manager";
TempData["Title"] = title;
}
<link rel="stylesheet" href="/css/portal-permissions.css" asp-append-version="true" />
<div class="container-fluid" IsPageAvailable="true">
    <form method="post" id="formList" data-page-partial-url="/IdentityModulePortalPageAccessGrants/GetGroupPermissions">
        @Html.AntiForgeryToken()
        <div class="card text shadow mb-4">

            <div class="card-body">
                <h2 class="card-title">@title</h2>
                <p class="card-text">Manage page and query access for each permission group.</p>

                <hr class="col-xs-12">
                @if (Model.Items.PortalPageDefinitions.Count == 0)
                {
                <div class="alert alert-danger" role="alert">
                    No Data available in Portal Permissions table.
                </div>
                }
                else
                {
                <div class="row mb-4">
                    <div class="col-md-4">
                        <label for="permissionGroupSelect" class="form-label font-weight-bold">Permission Group Name</label>
                        <select id="permissionGroupSelect" class="form-select searchable-select" asp-for="SelectedGroupName" asp-items="@Model.ComboList["PermissionGroups"].SetListWithSelected(Model.SelectedGroupName)" data-placeholder="Search for Group Name..." onchange="submitform();"></select>
                    </div>
                    <div class="col-md-4">
                        <label for="searchInput" class="form-label font-weight-bold">Search</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                    <span class="input-group-text" style="background: #f8f9fa; border-right: none;">
                                        <i class="fas fa-search" style="color: #6c757d;"></i>
                                    </span>
                            </div>
                            <input type="text" id="searchInput" class="form-control" placeholder="Search pages or queries..." style="border-left: none;" />
                        </div>
                    </div>
                </div>
                <div id="searchStatistics" class="row mb-3" style="display: none;">
                    <div class="col-12">
                        <div class="alert alert-info mb-0" style="padding: 12px 16px; border-radius: 8px;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle me-2"></i>
                                <span id="searchStatsText" style="font-size: 0.9rem;"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="noResultsMessage" class="row mb-4" style="display: none;">
                    <div class="col-12">
                        <div class="alert text-center" style="padding: 40px 20px; border-radius: 8px; background-color: #f8f9fa; border: 1px solid #e9ecef; border-left: 4px solid #6c757d;">
                            <i class="fas fa-search" style="font-size: 1.75rem; color: #6c757d; margin-bottom: 12px; display: block; opacity: 0.7;"></i>
                            <h5 style="color: #495057; margin-bottom: 8px; font-weight: 500;">No Results Found</h5>
                            <p style="color: #6c757d; margin: 0;">Nothing matched your search in this tab.</p>
                        </div>
                    </div>
                </div>
                <div id="grants-region" class="portal-list-region">
                    @await Html.PartialAsync("_Content", Model)
                </div>
                }
            </div>

        </div>

    </form>

    <div class="modal fade bd-example-modal-lg" id="itemDetailsModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document" id="itemDetailsContainer">
        </div>
    </div>

    <div aria-live="polite" aria-atomic="true" style="position: relative; min-height: 200px;">
        <div class="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
            <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-autohide="true" data-delay="3000">
                <div class="toast-header" style="background-color: #d4edda; color: #155724;">
                    <i class="fas fa-check-circle me-2"></i>
                    <strong class="me-auto">Success</strong>
                    <button type="button" class="ms-2 mb-1 close" data-bs-dismiss="toast" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="toast-body" style="background-color: #d4edda; color: #155724;">
                    Permission updated successfully.
                </div>
            </div>
            <div id="errorToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-autohide="true" data-delay="5000">
                <div class="toast-header" style="background-color: #f8d7da; color: #721c24;">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong class="me-auto">Error</strong>
                    <button type="button" class="ms-2 mb-1 close" data-bs-dismiss="toast" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="toast-body" style="background-color: #f8d7da; color: #721c24;">
                    An error occurred while updating the permission.
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid" IsPageAvailable="false">
    @await Html.PartialAsync("_NotAuthorized")
</div>
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
<script src="/js/lazyload.js"></script>
<script type="text/javascript">
    $("img.lazyload").lazyload();

    function initPgpUi($root) {
        if (!$root || !$root.length) {
            return;
        }

        $root.find('.ios-switch').each(function () {
            $(this).closest('.ios-switch-wrapper').toggleClass('checked', $(this).is(':checked'));
        });
    }

    function submitform() {
        if (typeof refreshListRegion === 'function' && document.getElementById('grants-region')) {
            refreshListRegion({
                regionId: 'grants-region',
                afterSwap: function () {
                    $('#searchInput').val('');
                    $('#searchStatistics').hide();
                    $('#noResultsMessage').hide();
                    initPgpUi($('#pgpRoot'));
                }
            });
            return;
        }
        $('#formList').submit();
    }

    function formatGrantLabel(raw) {
        if (!raw) {
            return '';
        }
        var s = String(raw).trim();
        // Compact PascalCase / camelCase → spaced words
        if (s.indexOf(' ') < 0 && /[a-z][A-Z]/.test(s)) {
            s = s.replace(/([a-z0-9])([A-Z])/g, '$1 $2')
                .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2');
        }
        return s.replace(/[A-Za-z0-9]+/g, function (word) {
            if (word.length <= 3 && word === word.toUpperCase()) {
                return word;
            }
            return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
        });
    }

    function checkBoxChanged(cbox) {
        var values = cbox.id.replace("cbox_", "").split("_");
        var UpdatePermissionGroupRequestData = {
            "permissionGroupName": values[0],
            "portalPagePermissionName": values[1] + values[2],
            "portalPagePermissionType": values[2],
            "value": cbox.checked ? 1 : 0
        };

        var $card = $(cbox).closest('.searchable-card');
        var cardEl = $card[0];
        var pageName = formatGrantLabel(
            (cardEl && cardEl.getAttribute('data-page-label'))
            || ($card.find('.pgp-page-name, .pgp-query-name').first().text() || '').trim()
            || (cardEl && cardEl.getAttribute('data-page'))
            || values[1]
        );
        var permissionType = values[2] || 'Permission';
        var statusText = cbox.checked ? 'granted' : 'revoked';
        var permissionText = pageName + ' (' + permissionType + ')';

        $.ajax({
            type: "POST",
            url: '@Url.Action("UpdatePermission")',
            data: UpdatePermissionGroupRequestData,
            dataType: 'json',
            success: function () {
                $('#successToast .toast-body').text('Permission ' + statusText + ' for: ' + permissionText);
                $('#successToast').toast('show');
            },
            error: function (xhr, textStatus, error) {
                var errorMessage = 'An error occurred while updating permission for: ' + permissionText;
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMessage = xhr.responseJSON.message;
                } else if (error) {
                    errorMessage = 'Error: ' + error + ' (for: ' + permissionText + ')';
                }
                $('#errorToast .toast-body').text(errorMessage);
                $('#errorToast').toast('show');
            }
        });
    }

    $(document).ready(function () {
        initPgpUi($('#pgpRoot'));

        $(document).on('click', '.pgp-tab', function () {
            var tab = $(this).data('tab');
            var $root = $('#pgpRoot');
            $root.find('.pgp-tab').removeClass('is-active').attr('aria-selected', 'false');
            $(this).addClass('is-active').attr('aria-selected', 'true');
            $root.find('.pgp-panel').attr('hidden', true);
            $root.find('.pgp-panel[data-panel="' + tab + '"]').removeAttr('hidden');
            $('#searchInput').trigger('input');
        });

        $(document).on('click', '[data-pgp-toggle]', function () {
            var kind = $(this).attr('data-pgp-toggle');
            var $host = kind === 'table'
                ? $(this).closest('.pgp-table-group')
                : $(this).closest('.pgp-module');
            if (!$host.length) {
                return;
            }
            var open = !$host.hasClass('is-open');
            $host.toggleClass('is-open', open);
            $(this).attr('aria-expanded', open ? 'true' : 'false');
        });

        $(document).on('keydown', '[data-pgp-toggle]', function (e) {
            if (e.key !== 'Enter' && e.key !== ' ') {
                return;
            }
            e.preventDefault();
            $(this).trigger('click');
        });

        // Scope to this page so Layout's shared switch handlers are not doubled.
        $(document).on('change', '#pgpRoot .ios-switch, #grants-region .ios-switch', function () {
            var $switch = $(this);
            $switch.closest('.ios-switch-wrapper').toggleClass('checked', $switch.is(':checked'));
            if (!$switch.data('processing')) {
                $switch.data('processing', true);
                checkBoxChanged(this);
                setTimeout(function () { $switch.data('processing', false); }, 100);
            }
        });

        $('#searchInput').on('keyup input paste', function () {
            var searchText = ($(this).val() || '').toLowerCase().trim();
            var $activePanel = $('#pgpRoot .pgp-panel:not([hidden])');
            var visibleCards = 0;
            var visibleModules = 0;

            $activePanel.find('.searchable-module').each(function () {
                var $module = $(this);
                var moduleVisible = 0;
                $module.find('.searchable-card').each(function () {
                    var $card = $(this);
                    var hay = [
                        $card.attr('data-page') || '',
                        $card.attr('data-table') || '',
                        $card.attr('data-module') || '',
                        $card.attr('data-endpoint') || '',
                        $card.attr('data-path') || ''
                    ].join(' ');
                    var match = !searchText || hay.indexOf(searchText) !== -1;
                    $card.toggle(match);
                    if (match) {
                        moduleVisible++;
                        visibleCards++;
                    }
                });

                $module.find('.pgp-table-group').each(function () {
                    var $table = $(this);
                    var any = $table.find('.searchable-card:visible').length > 0;
                    $table.toggle(any || !searchText);
                    if (searchText && any) {
                        $table.addClass('is-open');
                        $table.find('[data-pgp-toggle="table"]').attr('aria-expanded', 'true');
                    }
                });

                if (searchText) {
                    $module.toggle(moduleVisible > 0);
                    if (moduleVisible > 0) {
                        $module.addClass('is-open');
                        $module.find('> [data-pgp-toggle="module"]').attr('aria-expanded', 'true');
                        visibleModules++;
                    }
                } else {
                    $module.show();
                }

                var $badge = $module.find('.module-count-badge');
                var total = parseInt($badge.attr('data-total'), 10) || 0;
                if (searchText) {
                    $badge.text(moduleVisible + ' / ' + total);
                } else {
                    var kind = $module.data('kind');
                    $badge.text(total + (kind === 'queries' ? ' queries' : ' pages'));
                }
            });

            if (searchText) {
                $('#searchStatsText').html('Found <strong>' + visibleCards + '</strong> item(s) in <strong>' + visibleModules + '</strong> module(s).');
                $('#searchStatistics').show();
                $('#noResultsMessage').toggle(visibleCards === 0);
                $activePanel.toggle(visibleCards > 0);
            } else {
                $('#searchStatistics').hide();
                $('#noResultsMessage').hide();
                $activePanel.show();
            }
        });
    });
</script>
