@using QuickCode.Quickcode.Portal.Helpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Quickcode - QuickCode Microservices Generator</title>
    <link rel="icon" href="https://www.quickcode.net/favicon.ico" />
    <!--[if IE]>
    <link rel="shortcut icon" href="https://www.quickcode.net/favicon.ico" type="image/vnd.microsoft.icon" />
    <![endif]-->
    <environment include="Development">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link href="/font-awesome/css/all.css" rel="stylesheet" />
        <link href="/css/sb-admin-2.css" rel="stylesheet" />
        <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
        <link href="https://gitcdn.github.io/bootstrap-toggle/2.2.2/css/bootstrap-toggle.min.css" rel="stylesheet">
		<link href="/lib/jsoneditor/jsoneditor.min.css" rel="stylesheet" type="text/css" asp-append-version="true">
        <script src="/lib/jsoneditor/jsoneditor.min.js" asp-append-version="true"></script>
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" crossorigin="anonymous" />
        <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="/css/portal-entity-form.css" asp-append-version="true" />
        <link rel="stylesheet" href="/css/portal-list.css" asp-append-version="true" />
        <link rel="stylesheet" href="/css/portal-sidebar.css" asp-append-version="true" />
        <script>
            (function () {
                var w = parseInt(localStorage.getItem('sidebarWidthPx'), 10);
                if (!isNaN(w) && w >= 256 && w <= 480) {
                    document.documentElement.style.setProperty('--ps-width', w + 'px');
                }
            })();
        </script>
    </environment>
    <environment exclude="Development">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link href="/font-awesome/css/all.css" rel="stylesheet" />
        <link href="/css/sb-admin-2.css" rel="stylesheet" />
        <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
        <link href="https://gitcdn.github.io/bootstrap-toggle/2.2.2/css/bootstrap-toggle.min.css" rel="stylesheet">
		<link href="/lib/jsoneditor/jsoneditor.min.css" rel="stylesheet" type="text/css" asp-append-version="true">
        <script src="/lib/jsoneditor/jsoneditor.min.js" asp-append-version="true"></script>
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" crossorigin="anonymous" />
        <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="/css/portal-entity-form.css" asp-append-version="true" />
        <link rel="stylesheet" href="/css/portal-list.css" asp-append-version="true" />
        <link rel="stylesheet" href="/css/portal-sidebar.css" asp-append-version="true" />
        <script>
            (function () {
                var w = parseInt(localStorage.getItem('sidebarWidthPx'), 10);
                if (!isNaN(w) && w >= 256 && w <= 480) {
                    document.documentElement.style.setProperty('--ps-width', w + 'px');
                }
            })();
        </script>
    </environment>
    <style>
        /* Topbar sits flush; sticky + compact-on-scroll (see portal-sidebar.css / site.js) */
        .content-area {
            padding-top: 0;
            --portal-topbar-sticky-offset: 3.25rem;
        }
        .portal-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem 1rem;
            min-height: 3.25rem;
            height: auto;
            padding: 0.45rem 1.25rem;
            margin: 0 0 0.75rem;
            background: #fff;
            border-bottom: 1px solid #e3e6f0;
            overflow: visible;
            position: sticky;
            top: 0;
            z-index: 40; /* above sticky list pager (25) so breadcrumb menus stack correctly */
        }
        .portal-topbar__main {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            min-width: 0;
            flex: 1 1 auto;
        }
        .portal-breadcrumb {
            overflow: visible;
            min-width: 0;
        }
        .portal-bc-list {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.35rem;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .portal-bc-item {
            display: inline-flex;
            align-items: center;
        }
        .portal-bc-separator {
            display: inline-flex;
            align-items: center;
            color: #d1d3e2;
            font-size: 0.6rem;
            line-height: 1;
        }
        .portal-bc-link,
        .portal-bc-text {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            color: #4e73df;
            font-size: 0.875rem;
            font-weight: 500;
            text-decoration: none;
            line-height: 1.4;
        }
        .portal-bc-link:hover {
            color: #2e59d9;
            text-decoration: none;
        }
        .portal-bc-home-icon {
            font-size: 0.8rem;
            opacity: 0.85;
        }
        .portal-bc-current {
            display: inline-flex;
            align-items: center;
            padding: 0.2rem 0.65rem;
            border-radius: 999px;
            background: #eef2ff;
            color: #3b488e;
            font-size: 0.875rem;
            font-weight: 600;
            line-height: 1.4;
        }
        .portal-bc-switcher {
            display: inline-flex;
            position: relative;
            /* Own stacking context so .portal-bc-menu (z-index 1100) can sit
               above sticky list pager (z-index 25) when the menu overlaps it. */
            z-index: 40;
        }
        .portal-bc-trigger {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            border: 1px solid #d1d3e2;
            border-radius: 999px;
            padding: 0.2rem 0.75rem;
            background: #fff;
            color: #5a5c69;
            font-size: 0.875rem;
            font-weight: 500;
            line-height: 1.4;
            cursor: pointer;
        }
        .portal-bc-trigger:hover,
        .portal-bc-trigger:focus,
        .portal-bc-trigger.show {
            background: #f8f9fc;
            color: #4e73df;
            border-color: #bac8f3;
            outline: none;
            box-shadow: none;
        }
        .portal-bc-trigger::after {
            margin-left: 0.15rem;
            vertical-align: middle;
        }
        .portal-bc-menu {
            min-width: 12rem;
            max-height: 18rem;
            overflow-y: auto;
            border-color: #e3e6f0;
            font-size: 0.875rem;
            z-index: 1100;
        }
        .portal-bc-menu .dropdown-item.active {
            background: #eef2ff;
            color: #3b488e;
            font-weight: 600;
        }
        /* Page headers: breadcrumb already shows location — keep titles compact */
        .content-area .card-body > h1.card-title,
        .content-area .card-body > h2.card-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #5a5c69;
            margin-bottom: 0.35rem;
            line-height: 1.35;
        }
        .content-area .card-body > p.card-text {
            font-size: 0.875rem;
            color: #858796;
            margin-bottom: 0.85rem;
            line-height: 1.5;
        }
        .content-area .card-body > hr {
            margin-top: 0.25rem;
            margin-bottom: 1rem;
        }
        /* Active nav styles live in portal-sidebar.css */
    </style>
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    @{
        var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    }
    <meta name="request-verification-token" content="@antiforgeryTokens.RequestToken" />
</head>
<body id="page-top">
    <partial name="_CookieConsentPartial" />
    <!-- Page Wrapper -->
    <div id="wrapper">
        <!-- Sidebar -->
        <div class="portal-sidebar-backdrop" id="portalSidebarBackdrop" aria-hidden="true"></div>
        <nav class="navbar-nav portal-sidebar sidebar sidebar-dark bg-gradient-primary accordion" id="accordionSidebar" aria-label="Main navigation">
            <div class="portal-sidebar-visual" aria-hidden="true">
                <img class="portal-sidebar-visual__media"
                     src="/images/sidebar-visual.svg?v=9"
                     alt=""
                     decoding="async" />
                <div class="portal-sidebar-visual__veil"></div>
            </div>

            <div class="portal-sidebar-header">
                <div class="portal-sidebar-header-row">
                    <a class="portal-sidebar-brand" href="/">
                        <div class="portal-brand-logo-wrap">
                            <img class="portal-brand-logo" src="/images/logo_s1.png" alt="QuickCode" />
                        </div>
                    </a>
                    <button type="button" class="portal-sidebar-close d-md-none" id="portalSidebarClose" aria-label="Close menu">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="portal-sidebar-project" title="Quickcode">
                    <span class="portal-sidebar-project__badge" aria-hidden="true">
                        <i class="fas fa-layer-group"></i>
                    </span>
                    <span class="portal-sidebar-project__meta">
                        <span class="portal-sidebar-project__kicker">Project</span>
                        <span class="portal-sidebar-project__label">Quickcode</span>
                    </span>
                </div>
            </div>

            <div class="portal-sidebar-search-wrap">
                <label class="portal-sidebar-search mb-0 w-100" for="portalSidebarSearch">
                    <i class="fas fa-search portal-sidebar-search-icon" aria-hidden="true"></i>
                    <input type="search"
                           id="portalSidebarSearch"
                           class="portal-sidebar-search-input"
                           placeholder="Search menus..."
                           autocomplete="off"
                           aria-label="Search navigation" />
                    <button type="button" class="portal-sidebar-search-clear" id="portalSidebarSearchClear" aria-label="Clear search" hidden>
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </label>
            </div>

            <div class="portal-sidebar-body" id="portalSidebarNav">
            <div class="portal-nav-rail" aria-hidden="true">
                <div class="portal-nav-rail__indicator" id="portalNavRailIndicator">
                    <span class="portal-nav-rail__bar"></span>
                </div>
            </div>
            @{
                var isDashboard = PortalNavigationHelper.IsDashboardPage(Context);
            }
            <div class="nav-item@(isDashboard ? " portal-nav-current" : "")" data-nav-group="dashboard">
                <a class="nav-link portal-nav-link@(isDashboard ? " portal-nav-current-link" : "")" href="/" data-nav-search="dashboard"@(isDashboard ? Html.Raw(" aria-current=\"page\"") : null)>
                    <span class="nav-link-main">
                        <i class="fas fa-fw fa-tachometer-alt portal-nav-icon"></i>
                        <span class="portal-nav-label">Dashboard</span>
                    </span>
                </a>
            </div>

            <p class="portal-sidebar-section-label portal-sidebar-section-divider portal-sidebar-section--management">
                <span class="portal-sidebar-section-main">
                    <i class="fas fa-fw fa-sliders-h portal-sidebar-section-icon" aria-hidden="true"></i>
                    <span>Management</span>
                </span>
            </p>
            <sidebar-item title="Access Grant Managers" key="AccessGrantManagers"></sidebar-item>
            <sidebar-item title="Workflow Managers" key="WorkflowManagers"></sidebar-item>
            <sidebar-item title="Portal Settings" key="PortalSettings"></sidebar-item>
            <sidebar-item title="Permission Settings" key="PermissionSettings"></sidebar-item>
            <sidebar-item title="Audit Logs" key="AuditLogs"></sidebar-item>

            <p class="portal-sidebar-section-label portal-sidebar-section-divider portal-sidebar-section--modules">
                <span class="portal-sidebar-section-main">
                    <i class="fas fa-fw fa-cubes portal-sidebar-section-icon" aria-hidden="true"></i>
                    <span>Modules</span>
                </span>
            </p>
            <sidebar-item title="Tables" key="Tables"></sidebar-item>

            <p class="portal-sidebar-section-label portal-sidebar-section-divider portal-sidebar-section--queries">
                <span class="portal-sidebar-section-main">
                    <i class="fas fa-fw fa-chart-bar portal-sidebar-section-icon" aria-hidden="true"></i>
                    <span>Live Reports</span>
                </span>
            </p>
            <sidebar-item title="Live Reports" key="Queries"></sidebar-item>
            </div>

            <div class="portal-sidebar-search-empty" id="portalSidebarSearchEmpty" hidden>
                <i class="fas fa-search" aria-hidden="true"></i>
                <span>No matching menu items</span>
            </div>

            <div class="portal-sidebar-footer" aria-hidden="true"></div>

            <div class="portal-sidebar-resizer" id="portalSidebarResizer" role="separator" aria-orientation="vertical" aria-label="Resize sidebar" title="Drag to resize sidebar"></div>

        </nav>
        <!-- End of Sidebar -->



        <div id="content-wrapper" class="d-flex flex-column">
            <!-- Main Content -->
            @{
                var isDashboardPage = PortalNavigationHelper.IsDashboardPage(Context);
            }
            <div id="content" class="content-area@(isDashboardPage ? " portal-is-dashboard" : "")">
                <div class="portal-topbar-scroll-sent" aria-hidden="true"></div>
                <div class="portal-topbar">
                    <div class="portal-topbar__main">
                        <button id="sidebarToggleTop" class="btn btn-link rounded-circle mr-2 d-md-none p-1" type="button">
                            <i class="fa fa-bars"></i>
                        </button>
                        @if (isDashboardPage)
                        {
                            <nav aria-label="breadcrumb" class="portal-breadcrumb flex-grow-1">
                                <ol class="portal-bc-list">
                                    <li class="portal-bc-item is-current">
                                        <span class="portal-bc-current" title="Live module health, traffic, latency, and access operations.">Dashboard</span>
                                    </li>
                                </ol>
                            </nav>
                        }
                        else
                        {
                            @await Component.InvokeAsync("PortalBreadcrumb")
                        }
                    </div>
                    @if (IsSectionDefined("TopbarActions"))
                    {
                        <div class="portal-topbar__actions">
                            @await RenderSectionAsync("TopbarActions", required: false)
                        </div>
                    }
                    <div class="dropdown portal-topbar-account">
                        <button type="button"
                                class="portal-topbar-user-btn"
                                id="portalUserMenuToggle"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="true"
                                data-bs-display="static"
                                aria-expanded="false"
                                aria-label="Account menu"
                                title="Account">
                            @await Component.InvokeAsync(nameof(UserOperation))
                            <i class="fas fa-chevron-down portal-topbar-user-caret" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end portal-topbar-user-menu" aria-labelledby="portalUserMenuToggle">
                            <li class="portal-topbar-user-menu__profile">
                                @await Component.InvokeAsync(nameof(UserOperation))
                            </li>
                            <li>
                                <hr class="dropdown-divider portal-topbar-user-menu__divider" />
                            </li>
                            <li>
                                <button type="button"
                                        class="dropdown-item portal-topbar-user-menu__item"
                                        data-bs-toggle="modal"
                                        data-bs-target="#changePasswordModal">
                                    <i class="fas fa-key" aria-hidden="true"></i>
                                    <span>Change password</span>
                                </button>
                            </li>
                            <li>
                                <button type="button"
                                        class="dropdown-item portal-topbar-user-menu__item portal-topbar-user-menu__logout"
                                        data-bs-toggle="modal"
                                        data-bs-target="#logoutModal">
                                    <i class="fas fa-sign-out-alt" aria-hidden="true"></i>
                                    <span>Logout</span>
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
                @RenderBody()

            </div>


            <!-- Footer -->
            <footer class="sticky-footer portal-sticky-footer bg-white">
                <div class="copyright text-center">
                    <span>Copyright &copy; QuickCode @Html.Raw(DateTime.Now.Year.ToString()). All rights reserved.</span>
                </div>
            </footer>
            <!-- End of Footer -->
        </div>
    </div>
    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="/Login/Logout">Logout</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Change password modal -->
    <div class="modal fade" id="changePasswordModal" tabindex="-1" role="dialog" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form id="changePasswordForm" autocomplete="off">
                    <div class="modal-header">
                        <h5 class="modal-title" id="changePasswordModalLabel">Change password</h5>
                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted mb-3">Enter your current password, then choose a new one.</p>
                        <div class="mb-3">
                            <label class="form-label" for="changePasswordOld">Current password</label>
                            <input id="changePasswordOld"
                                   name="oldPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="changePasswordNew">New password</label>
                            <input id="changePasswordNew"
                                   name="newPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   minlength="8"
                                   required />
                            <div class="form-text">At least 8 characters, with uppercase, lowercase, a number, and a symbol.</div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label" for="changePasswordConfirm">Confirm new password</label>
                            <input id="changePasswordConfirm"
                                   name="confirmPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   minlength="8"
                                   required />
                        </div>
                        <div id="changePasswordError" class="alert alert-danger mt-3 mb-0 d-none" role="alert"></div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" type="submit" id="changePasswordSubmit">
                            Update password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-labelledby="imageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="imageModalLabel">Uml Diagram Preview</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                        
                    </button>
                </div>
                <div class="modal-body text-center">
                    <img src="/images/loading.svg" id="modalImage" class="img-fluid" alt="Original Image" />
                </div>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;" aria-live="polite" aria-atomic="true">
        <div id="portalToast" class="toast align-items-center border-0 text-white portal-toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="6000">
            <div class="d-flex align-items-center w-100">
                <div class="toast-body d-flex align-items-center gap-2 py-2">
                    <i id="portalToastIcon" class="fas fa-check-circle" aria-hidden="true"></i>
                    <span id="portalToastBody"></span>
                </div>
                <button type="button" class="portal-toast-close" data-bs-dismiss="toast" aria-label="Close">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>

    <environment include="Development">
        <script src="/lib/jquery/dist/jquery.min.js"></script>
        <script src="/js/bootstrap-toggle.js"></script>
        <script src="/js/lazyload.js"></script>
        <script src="/jquery-easing/jquery.easing.min.js"></script>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <script src="/js/sb-admin-2.js"></script>

        <script src="/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

        <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/tr.js" crossorigin="anonymous"></script>

        <script src="https://gitcdn.github.io/bootstrap-toggle/2.2.2/js/bootstrap-toggle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        <script src="/js/site.js" asp-append-version="true"></script>
        <script src="/js/portal-list.js" asp-append-version="true"></script>

    </environment>
    <environment exclude="Development">
         <script src="/lib/jquery/dist/jquery.min.js"></script>
        <script src="/js/bootstrap-toggle.js"></script>
        <script src="/js/lazyload.js"></script>
        <script src="/jquery-easing/jquery.easing.min.js"></script>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <script src="/js/sb-admin-2.js"></script>

        <script src="/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

        <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/tr.js" crossorigin="anonymous"></script>

        <script src="https://gitcdn.github.io/bootstrap-toggle/2.2.2/js/bootstrap-toggle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        <script src="/js/site.js" asp-append-version="true"></script>
        <script src="/js/portal-list.js" asp-append-version="true"></script>
    </environment>

    <style>
        /* Restore lighter text colors for better readability */
        body {
            color: #858796 !important;
            font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        
        .text-dark, h1, h2, h3, h4, h5, h6 {
            color: #5a5c69 !important;
        }
        
        .text-muted {
            color: #858796 !important;
        }
        
        @@media (min-width: 768px) {
            #content-wrapper footer.sticky-footer {
                width: 100% !important;
                margin-left: 0 !important;
            }
        }
    </style>
    <script>
        // Initialize sidebar collapse after page load
        // Initialize sidebar collapse - Bootstrap 5 compatible
        $(document).ready(function() {
            // Wait for Bootstrap 5 to be loaded
            function initSidebarCollapse() {
                if (typeof bootstrap === 'undefined' || typeof $ === 'undefined') {
                    setTimeout(initSidebarCollapse, 100);
                    return;
                }
                
                // Bootstrap 5 collapse should work automatically with data-bs-toggle and data-bs-target
                // But we need to ensure proper event handling for accordion behavior
                
                // Update aria-expanded on collapse events
                $('#accordionSidebar .collapse').on('show.bs.collapse', function() {
                    var collapseId = '#' + $(this).attr('id');
                    var $trigger = $('[data-bs-target="' + collapseId + '"]');
                    if ($trigger.length) {
                        $trigger.attr('aria-expanded', 'true').removeClass('collapsed');
                    }
                });
                
                $('#accordionSidebar .collapse').on('hide.bs.collapse', function() {
                    var collapseId = '#' + $(this).attr('id');
                    var $trigger = $('[data-bs-target="' + collapseId + '"]');
                    if ($trigger.length) {
                        $trigger.attr('aria-expanded', 'false').addClass('collapsed');
                    }
                });
                
                // Ensure collapse triggers work - Bootstrap 5 should handle this automatically
                // but we add explicit click handler as fallback
                $('#accordionSidebar [data-bs-toggle="collapse"]').on('click', function(e) {
                    e.stopPropagation();
                    var target = $(this).attr('data-bs-target');
                    if (target && typeof bootstrap !== 'undefined') {
                        var $target = $(target);
                        var collapseInstance = bootstrap.Collapse.getInstance($target[0]);
                        if (!collapseInstance) {
                            collapseInstance = new bootstrap.Collapse($target[0], {
                                toggle: true,
                                parent: '#accordionSidebar'
                            });
                        } else {
                            collapseInstance.toggle();
                        }
                    }
                });
            }
            
            initSidebarCollapse();
        });
        
        // Close sidebar collapse menus when clicking outside - separate handler
        $(document).on('click', function(e) {
            // Check if click is outside sidebar and not on a sidebar toggle button
            var $target = $(e.target);
            var isSidebarClick = $target.closest('#accordionSidebar').length > 0;
            var isSidebarToggle = $target.closest('#sidebarToggleTop').length > 0;
            
            if (!isSidebarClick && !isSidebarToggle) {
                // Close all open collapses in sidebar
                $('#accordionSidebar .collapse.show').each(function() {
                    if (typeof bootstrap !== 'undefined') {
                        var collapseInstance = bootstrap.Collapse.getInstance(this);
                        if (collapseInstance) {
                            collapseInstance.hide();
                        }
                    } else {
                        $(this).collapse('hide');
                    }
                });
            }
        });

        function initPortalSidebarSearch() {
            var $input = $('#portalSidebarSearch');
            var $clear = $('#portalSidebarSearchClear');
            var $empty = $('#portalSidebarSearchEmpty');
            var searchStorageKey = 'portalSidebarSearchQuery';
            if (!$input.length) {
                return;
            }

            function normalizeSearchText(value) {
                return (value || '').toString().toLowerCase().trim();
            }

            function saveSidebarSearchQuery() {
                var raw = ($input.val() || '').toString().trim();
                try {
                    if (raw) {
                        localStorage.setItem(searchStorageKey, raw);
                    } else {
                        localStorage.removeItem(searchStorageKey);
                    }
                } catch (e) {
                    /* storage unavailable */
                }
            }

            function restoreSidebarSearchQuery() {
                try {
                    return localStorage.getItem(searchStorageKey) || '';
                } catch (e) {
                    return '';
                }
            }

            function matchesSearch(text, query) {
                return normalizeSearchText(text).indexOf(query) !== -1;
            }

            function getItemText($el) {
                var attr = $el.attr('data-nav-search');
                if (attr) {
                    return attr;
                }
                var label = $el.find('.portal-nav-label').first().text();
                return label || $el.text();
            }

            function updateSectionLabels($nav) {
                $nav.find('.portal-sidebar-section-label').each(function() {
                    var $label = $(this);
                    var hasVisible = false;
                    var $next = $label.next();
                    while ($next.length && !$next.hasClass('portal-sidebar-section-label')) {
                        if (!$next.hasClass('portal-nav-hidden')) {
                            hasVisible = true;
                            break;
                        }
                        $next = $next.next();
                    }
                    $label.toggleClass('portal-nav-hidden', !hasVisible);
                });
            }

            function expandSearchCollapse($collapse, $trigger) {
                if (!$collapse.length) {
                    return;
                }
                $collapse.removeClass('portal-nav-hidden collapsing').addClass('show').css('height', '');
                if ($trigger.length) {
                    $trigger.removeClass('collapsed portal-nav-hidden').attr('aria-expanded', 'true');
                }
            }

            function applySidebarSearch() {
                var query = normalizeSearchText($input.val());
                var $nav = $('#portalSidebarNav');

                saveSidebarSearchQuery();

                $nav.find('.portal-nav-hidden').removeClass('portal-nav-hidden');
                $empty.prop('hidden', true);

                if ($clear.length) {
                    $clear.prop('hidden', !query);
                }

                if (!query) {
                    return;
                }

                $nav.find('[data-nav-group="dashboard"]').each(function() {
                    var $item = $(this);
                    var text = getItemText($item.find('.portal-nav-link').first());
                    $item.toggleClass('portal-nav-hidden', !matchesSearch(text, query));
                });

                $nav.find('.portal-nav-subitem, .collapse-item').each(function() {
                    var $item = $(this);
                    var text = $item.attr('data-nav-search') || $item.text();
                    $item.toggleClass('portal-nav-hidden', !matchesSearch(text, query));
                });

                // Queries: table groups first — hide tables with zero matching queries
                // (unless the table label itself matches the search).
                $nav.find('.portal-nav-table-group').each(function() {
                    var $group = $(this);
                    var $trigger = $group.children('.portal-nav-table-trigger');
                    var $collapse = $group.children('.portal-nav-table-collapse');
                    var triggerMatch = matchesSearch(getItemText($trigger), query);

                    if (triggerMatch) {
                        $collapse.find('.portal-nav-subitem, .collapse-item').removeClass('portal-nav-hidden');
                    }

                    var hasVisibleChild = $collapse.find('.portal-nav-subitem:not(.portal-nav-hidden), .collapse-item:not(.portal-nav-hidden)').length > 0;
                    var visible = triggerMatch || hasVisibleChild;

                    $group.toggleClass('portal-nav-hidden', !visible);
                    $trigger.toggleClass('portal-nav-hidden', !visible);
                    $collapse.toggleClass('portal-nav-hidden', !visible);

                    if (visible) {
                        expandSearchCollapse($collapse, $trigger);
                    }
                });

                // Module / section collapses (skip table triggers — handled above)
                $nav.find('[data-bs-toggle="collapse"]').not('.portal-nav-table-trigger').each(function() {
                    var $trigger = $(this);
                    var triggerText = getItemText($trigger);
                    var target = $trigger.attr('data-bs-target');
                    var $collapse = target ? $(target) : $();
                    var triggerMatch = matchesSearch(triggerText, query);

                    if (triggerMatch) {
                        // Tables section: reveal direct leaf links
                        $collapse.find('.portal-collapse-inner').children('.portal-nav-subitem, .collapse-item').removeClass('portal-nav-hidden');
                        // Queries: module match reveals every table + query under it
                        $collapse.find('.portal-nav-table-group').each(function() {
                            var $tg = $(this);
                            var $tt = $tg.children('.portal-nav-table-trigger');
                            var $tc = $tg.children('.portal-nav-table-collapse');
                            $tg.add($tt).add($tc).removeClass('portal-nav-hidden');
                            $tc.find('.portal-nav-subitem, .collapse-item').removeClass('portal-nav-hidden');
                            expandSearchCollapse($tc, $tt);
                        });
                    }

                    var hasVisibleChild =
                        $collapse.find('.portal-nav-subitem:not(.portal-nav-hidden), .collapse-item:not(.portal-nav-hidden)').length > 0 ||
                        $collapse.find('.portal-nav-table-group:not(.portal-nav-hidden)').length > 0;

                    var visible = triggerMatch || hasVisibleChild;

                    $trigger.toggleClass('portal-nav-hidden', !visible);
                    $collapse.toggleClass('portal-nav-hidden', !visible);

                    if (visible && (hasVisibleChild || triggerMatch)) {
                        expandSearchCollapse($collapse, $trigger);
                    }
                });

                $nav.find('.portal-nav-group').each(function() {
                    var $group = $(this);
                    var hasVisible = $group.find('.portal-nav-link:not(.portal-nav-hidden), .portal-nav-table-trigger:not(.portal-nav-hidden), .portal-nav-table-group:not(.portal-nav-hidden), .portal-nav-subitem:not(.portal-nav-hidden), .collapse-item:not(.portal-nav-hidden)').length > 0;
                    $group.toggleClass('portal-nav-hidden', !hasVisible);
                });

                updateSectionLabels($nav);

                var anyVisible = $nav.find('.nav-item:not(.portal-nav-hidden), .portal-nav-group:not(.portal-nav-hidden)').length > 0;
                $empty.prop('hidden', anyVisible);
            }

            function scheduleSidebarSearchRestore() {
                if (!normalizeSearchText($input.val())) {
                    return;
                }
                applySidebarSearch();
            }

            $input.on('input', applySidebarSearch);
            $input.on('keydown', function(e) {
                if (e.key === 'Escape') {
                    $input.val('');
                    applySidebarSearch();
                }
            });

            if ($clear.length) {
                $clear.on('click', function() {
                    $input.val('').trigger('focus');
                    applySidebarSearch();
                });
            }

            var savedQuery = restoreSidebarSearchQuery();
            if (savedQuery) {
                $input.val(savedQuery);
            }
            applySidebarSearch();
            $input.data('portalApplySearch', applySidebarSearch);

            setTimeout(scheduleSidebarSearchRestore, 0);
            setTimeout(scheduleSidebarSearchRestore, 100);
            setTimeout(scheduleSidebarSearchRestore, 300);
        }

        function initPortalSidebarMobile() {
            var $backdrop = $('#portalSidebarBackdrop');
            var $sidebar = $('#accordionSidebar');

            function isMobileViewport() {
                return window.innerWidth < 768;
            }

            function closeMobileSidebar() {
                if (!isMobileViewport()) {
                    return;
                }
                $('body').addClass('sidebar-toggled');
                $sidebar.addClass('toggled');
                updateMobileState();
            }

            function updateMobileState() {
                if (!isMobileViewport()) {
                    $('body').removeClass('portal-sidebar-mobile-open');
                    $backdrop.attr('aria-hidden', 'true');
                    return;
                }

                var isOpen = !$sidebar.hasClass('toggled');
                $('body').toggleClass('portal-sidebar-mobile-open', isOpen);
                $backdrop.attr('aria-hidden', isOpen ? 'false' : 'true');

                if (isOpen) {
                    var reapplySearch = $('#portalSidebarSearch').data('portalApplySearch');
                    if (typeof reapplySearch === 'function') {
                        reapplySearch();
                    }
                }
            }

            if ($sidebar.data('portalMobileInit')) {
                updateMobileState();
                return;
            }
            $sidebar.data('portalMobileInit', true);

            $backdrop.on('click', closeMobileSidebar);
            $('#portalSidebarClose').on('click', closeMobileSidebar);

            $(document).on('click', '#sidebarToggleTop', function() {
                setTimeout(updateMobileState, 80);
            });

            $(window).on('resize.portalSidebarMobile', function() {
                updateMobileState();
            });

            $sidebar.on('click', '.portal-nav-subitem, .portal-nav-link[href]:not([href="#"])', function() {
                if (isMobileViewport() && !$(this).is('[data-bs-toggle="collapse"]')) {
                    closeMobileSidebar();
                }
            });

            updateMobileState();
        }

        function initPortalSidebarResize() {
            var sidebar = document.getElementById('accordionSidebar');
            var resizer = document.getElementById('portalSidebarResizer');
            if (!sidebar || !resizer) {
                return;
            }

            var minWidth = 256;
            var maxWidth = 480;
            var storageKey = 'sidebarWidthPx';

            function applySidebarWidth(px) {
                var width = Math.round(Math.max(minWidth, Math.min(maxWidth, px)));
                document.documentElement.style.setProperty('--ps-width', width + 'px');
                localStorage.setItem(storageKey, String(width));
            }

            var savedWidth = parseInt(localStorage.getItem(storageKey), 10);
            if (!isNaN(savedWidth)) {
                applySidebarWidth(savedWidth);
            }

            var startX = 0;
            var startWidth = 0;
            var isDragging = false;

            function onPointerMove(clientX) {
                if (!isDragging) {
                    return;
                }
                applySidebarWidth(startWidth + (clientX - startX));
            }

            function stopResize() {
                if (!isDragging) {
                    return;
                }
                isDragging = false;
                sidebar.classList.remove('is-resizing');
                document.body.style.cursor = '';
                document.body.style.userSelect = '';
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', stopResize);
            }

            function onMouseMove(e) {
                onPointerMove(e.clientX);
            }

            resizer.addEventListener('mousedown', function(e) {
                if (sidebar.classList.contains('toggled') || window.innerWidth < 768) {
                    return;
                }
                e.preventDefault();
                isDragging = true;
                startX = e.clientX;
                startWidth = sidebar.getBoundingClientRect().width;
                sidebar.classList.add('is-resizing');
                document.body.style.cursor = 'col-resize';
                document.body.style.userSelect = 'none';
                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', stopResize);
            });
        }

        function initPortalBreadcrumbDropdowns() {
            if (typeof bootstrap === 'undefined' || !bootstrap.Dropdown) {
                return;
            }

            document.querySelectorAll('.portal-bc-trigger[data-bs-toggle="dropdown"], .portal-topbar-user-btn[data-bs-toggle="dropdown"]').forEach(function(el) {
                bootstrap.Dropdown.getOrCreateInstance(el);
            });
        }
        
        function isPortalMobileViewport() {
            return window.innerWidth < 768;
        }

        function closeMobileSidebarDrawer() {
            if (!isPortalMobileViewport()) {
                return;
            }
            $('body').addClass('sidebar-toggled');
            $('#accordionSidebar').addClass('toggled');
        }

        function syncPortalNavParentActive() {
            var $nav = $('#portalSidebarNav');
            $nav.find('.nav-link.portal-nav-parent-active').removeClass('portal-nav-parent-active');

            $nav.find('.portal-nav-subitem.active, .collapse-item.active').each(function() {
                var $collapse = $(this).closest('.collapse');
                var collapseId = $collapse.attr('id');
                if (!collapseId) {
                    return;
                }
                $nav.find('[data-bs-target="#' + collapseId + '"]').addClass('portal-nav-parent-active');
            });
        }

        function syncPortalNavRailIndicator(options) {
            var nav = document.getElementById('portalSidebarNav');
            var indicator = document.getElementById('portalNavRailIndicator');
            if (!nav || !indicator) {
                return;
            }

            var active =
                nav.querySelector('.portal-nav-subitem.active, .collapse-item.active') ||
                nav.querySelector('.nav-item.portal-nav-current > .nav-link');

            if (!active || active.classList.contains('portal-nav-hidden') || active.offsetParent === null) {
                indicator.classList.remove('is-visible');
                return;
            }

            var navRect = nav.getBoundingClientRect();
            var activeRect = active.getBoundingClientRect();
            var top = activeRect.top - navRect.top + nav.scrollTop;
            var height = Math.max(16, Math.min(24, activeRect.height * 0.58));
            var y = top + (activeRect.height - height) / 2;

            // Prefer nested Table→Query rail when present; else Module→child rail.
            var nestedCollapse = active.closest('.portal-nav-table-collapse');
            var collapseInner = active.closest('.collapse-inner, .portal-collapse-inner');
            var x;

            if (nestedCollapse) {
                var nestedProbe = document.createElement('span');
                nestedProbe.setAttribute('aria-hidden', 'true');
                nestedProbe.style.cssText = 'position:absolute;left:var(--ps-tree-rail-x-nested);top:0;width:1px;height:1px;visibility:hidden;pointer-events:none;';
                nestedCollapse.appendChild(nestedProbe);
                var nestedProbeRect = nestedProbe.getBoundingClientRect();
                x = nestedProbeRect.left - navRect.left - 1;
                nestedProbe.remove();
            } else if (collapseInner) {
                var probe = document.createElement('span');
                probe.setAttribute('aria-hidden', 'true');
                probe.style.cssText = 'position:absolute;left:var(--ps-tree-rail-x);top:0;width:1px;height:1px;visibility:hidden;pointer-events:none;';
                collapseInner.appendChild(probe);
                var probeRect = probe.getBoundingClientRect();
                x = probeRect.left - navRect.left - 1;
                probe.remove();
            } else {
                x = activeRect.left - navRect.left + 2;
            }

            indicator.style.height = height + 'px';
            indicator.style.transform = 'translate3d(' + Math.max(0, x) + 'px, ' + Math.max(0, y) + 'px, 0)';
            indicator.classList.add('is-visible');
        }

        function initPortalNavRail() {
            var nav = document.getElementById('portalSidebarNav');
            if (!nav) {
                return;
            }

            var schedule = function() {
                window.requestAnimationFrame(function() {
                    syncPortalNavRailIndicator();
                });
            };

            schedule();

            nav.addEventListener('scroll', schedule, { passive: true });
            $(window).on('resize.portalNavRail', schedule);
            $('#accordionSidebar').on('shown.bs.collapse hidden.bs.collapse', schedule);

            var observer = new MutationObserver(schedule);
            observer.observe(nav, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'hidden', 'aria-current'] });
        }

        function initPortalSidebarScrollMemory() {
            var nav = document.getElementById('portalSidebarNav');
            var sidebar = document.getElementById('accordionSidebar');
            if (!nav || !sidebar) {
                return;
            }

            var stateKey = 'portalSidebarNavState';
            var saveTimer = null;

            function collectOpenCollapseIds() {
                var openIds = [];
                nav.querySelectorAll('.collapse.show').forEach(function(el) {
                    if (el.id) {
                        openIds.push(el.id);
                    }
                });
                return openIds;
            }

            function getActiveNavItem() {
                return nav.querySelector('.portal-nav-subitem.active, .collapse-item.active') ||
                    nav.querySelector('.nav-item.portal-nav-current > .nav-link');
            }

            function itemOffsetInNav(el) {
                if (!el) {
                    return 0;
                }
                return el.getBoundingClientRect().top - nav.getBoundingClientRect().top;
            }

            function readState() {
                try {
                    var raw = sessionStorage.getItem(stateKey);
                    return raw ? JSON.parse(raw) : null;
                } catch (e) {
                    return null;
                }
            }

            function writeState(state) {
                try {
                    sessionStorage.setItem(stateKey, JSON.stringify(state));
                } catch (e) {
                    /* storage unavailable */
                }
            }

            function captureStateForPath(path, clickedEl) {
                writeState({
                    path: path,
                    scrollTop: nav.scrollTop,
                    itemOffset: itemOffsetInNav(clickedEl || getActiveNavItem()),
                    openIds: collectOpenCollapseIds()
                });
            }

            function expandCollapseIds(openIds) {
                if (!openIds || !openIds.length) {
                    return;
                }

                openIds.forEach(function(id) {
                    var el = document.getElementById(id);
                    if (!el) {
                        return;
                    }

                    el.classList.add('show');
                    el.style.height = '';
                    el.classList.remove('collapsing', 'portal-nav-hidden');

                    var trigger = sidebar.querySelector('[data-bs-target="#' + id + '"]');
                    if (trigger) {
                        trigger.classList.remove('collapsed', 'portal-nav-hidden');
                        trigger.setAttribute('aria-expanded', 'true');
                    }
                });
            }

            function applyScrollFromState(state) {
                var active = getActiveNavItem();
                if (active && typeof state.itemOffset === 'number') {
                    var absoluteTop = active.getBoundingClientRect().top - nav.getBoundingClientRect().top + nav.scrollTop;
                    nav.scrollTop = Math.max(0, absoluteTop - state.itemOffset);
                    return;
                }

                if (typeof state.scrollTop === 'number' && state.scrollTop >= 0) {
                    nav.scrollTop = state.scrollTop;
                }
            }

            function restoreState() {
                var state = readState();
                var active = getActiveNavItem();

                if (state && state.path === window.location.pathname) {
                    expandCollapseIds(state.openIds);
                    // Layout after expanding, then pin item to the same viewport offset as click time.
                    window.requestAnimationFrame(function() {
                        applyScrollFromState(state);
                        syncPortalNavParentActive();
                        syncPortalNavRailIndicator();
                    });
                    return;
                }

                if (active && !active.classList.contains('portal-nav-hidden') && active.offsetParent !== null) {
                    active.scrollIntoView({ block: 'center', inline: 'nearest' });
                }

                window.requestAnimationFrame(function() {
                    syncPortalNavRailIndicator();
                });
            }

            function persistCurrentView() {
                var active = getActiveNavItem();
                writeState({
                    path: window.location.pathname,
                    scrollTop: nav.scrollTop,
                    itemOffset: itemOffsetInNav(active),
                    openIds: collectOpenCollapseIds()
                });
            }

            function schedulePersist() {
                if (saveTimer) {
                    clearTimeout(saveTimer);
                }
                saveTimer = setTimeout(persistCurrentView, 80);
            }

            // Capture exact menu pose at the moment user clicks a leaf link.
            sidebar.addEventListener('click', function(e) {
                var link = e.target.closest('a.portal-nav-subitem, a.collapse-item, a.nav-link[href]');
                if (!link) {
                    return;
                }

                var href = link.getAttribute('href');
                if (!href || href === '#' || link.getAttribute('data-bs-toggle') === 'collapse') {
                    return;
                }

                var path = href;
                try {
                    path = new URL(href, window.location.origin).pathname;
                } catch (err) {
                    /* keep href */
                }

                captureStateForPath(path, link);
            }, true);

            nav.addEventListener('scroll', schedulePersist, { passive: true });
            window.addEventListener('pagehide', persistCurrentView);
            $('#accordionSidebar').on('shown.bs.collapse hidden.bs.collapse', schedulePersist);

            window.requestAnimationFrame(function() {
                window.requestAnimationFrame(restoreState);
            });

            // After search restore / fonts, re-pin to the clicked pose.
            setTimeout(restoreState, 420);
        }

        function forceDesktopSidebarExpanded() {
            if (isPortalMobileViewport()) {
                return;
            }
            $('#accordionSidebar').removeClass('toggled');
            $('body').removeClass('sidebar-toggled');
        }

        $(document).ready(function() {
            initPortalBreadcrumbDropdowns();
            initPortalSidebarSearch();
            initPortalSidebarResize();
            initPortalSidebarMobile();
            syncPortalNavParentActive();
            initPortalNavRail();
            initPortalSidebarScrollMemory();

            forceDesktopSidebarExpanded();

            function closeSidebarCollapsesIfDrawerClosed() {
                if (!isPortalMobileViewport()) {
                    return;
                }
                var isDrawerClosed = $('#accordionSidebar').hasClass('toggled') || $('body').hasClass('sidebar-toggled');
                if (!isDrawerClosed) {
                    return;
                }

                $('#accordionSidebar .collapse').each(function() {
                    var $collapse = $(this);
                    var collapseId = '#' + $collapse.attr('id');
                    var $trigger = $('#accordionSidebar [data-bs-target="' + collapseId + '"]');

                    $collapse.removeClass('show');
                    if ($trigger.length) {
                        $trigger.addClass('collapsed').attr('aria-expanded', 'false');
                    }

                    if (typeof bootstrap !== 'undefined' && bootstrap.Collapse) {
                        var instance = bootstrap.Collapse.getInstance($collapse[0]);
                        if (instance) {
                            instance.hide();
                        }
                    }
                });
            }

            var isMobile = isPortalMobileViewport();

            if (isMobile) {
                closeMobileSidebarDrawer();
                closeSidebarCollapsesIfDrawerClosed();
                initPortalSidebarMobile();
                // sb-admin-2 also runs on ready; re-assert closed state once more
                setTimeout(function() {
                    closeMobileSidebarDrawer();
                    closeSidebarCollapsesIfDrawerClosed();
                    initPortalSidebarMobile();
                }, 50);
            } else {
                forceDesktopSidebarExpanded();
            }

            setTimeout(forceDesktopSidebarExpanded, 200);

            setTimeout(function() {
                var reapplySearch = $('#portalSidebarSearch').data('portalApplySearch');
                if (typeof reapplySearch === 'function') {
                    reapplySearch();
                }
            }, 350);

             // Update wrapper classes based on checkbox state
        $('.ios-switch').each(function() {
            var $wrapper = $(this).closest('.ios-switch-wrapper');
            if ($(this).is(':checked')) {
                $wrapper.addClass('checked');
            } else {
                $wrapper.removeClass('checked');
            }
        });
        
        // Update visual track when the (often opacity:0) checkbox changes.
        // Do not call preventDefault on touchstart/touchend — that blocks the native
        // checkbox on iOS when the tap hits .ios-switch (covers the full switch).
        $(document).on('change', '.ios-switch', function() {
            var $wrapper = $(this).closest('.ios-switch-wrapper');
            $wrapper.toggleClass('checked', $(this).is(':checked'));
        });

        $(document).on('click', '.ios-switch-wrapper', function(e) {
            if ($(e.target).is('.ios-switch') || $(e.target).closest('.ios-switch').length) {
                return;
            }
            var $switch = $(this).find('.ios-switch');
            if (!$switch.length || $switch.is(':disabled')) {
                return;
            }
            $switch.prop('checked', !$switch.prop('checked')).trigger('change');
        });

            $(window).on('resize', function() {
                var newIsMobile = isPortalMobileViewport();
                if (newIsMobile !== isMobile) {
                    isMobile = newIsMobile;
                    if (!isMobile) {
                        forceDesktopSidebarExpanded();
                    } else {
                        closeMobileSidebarDrawer();
                        closeSidebarCollapsesIfDrawerClosed();
                        initPortalSidebarMobile();
                    }
                }
            });
        });
    </script>
