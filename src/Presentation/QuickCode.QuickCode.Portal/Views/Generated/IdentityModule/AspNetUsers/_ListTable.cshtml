@using QuickCode.QuickCode.Portal.Models.IdentityModule
@using QuickCode.QuickCode.Portal.Helpers
@inject IPortalPagePermissionManager PortalPagePermissions
@model IdentityModule.AspNetUserData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex };
    var areaName = ViewContext.RouteData.Values["Area"]?.ToString() ?? string.Empty;
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;
    var actionName = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
    var ops = await PortalPagePermissions.GetPagePermission($"{areaName}{controllerName}", actionName);
}
@if (Model.List.Count == 0)
{
    <div class="alert alert-danger" role="alert">
        No Data available in IdentityModule.AspNetUser table.
    </div>
}
else
{
    <vc:pager pager-data=pagerData></vc:pager>
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    @PortalOperationButtonsHtml.Cell(ops, "Header", areaName, controllerName)
                    <th class="portal-col" data-col-type="text" data-col-key="Id">ID</th>
<th class="portal-col" data-col-type="text" data-col-key="FirstName">First Name</th>
<th class="portal-col" data-col-type="text" data-col-key="LastName">Last Name</th>
<th class="portal-col" data-col-type="fk" data-col-key="PermissionGroupName">Permission Group Name</th>
<th class="portal-col" data-col-type="text" data-col-key="UserName">User Name</th>
<th class="portal-col" data-col-type="text" data-col-key="NormalizedUserName">Normalized User Name</th>
<th class="portal-col" data-col-type="text" data-col-key="Email">Email</th>
<th class="portal-col" data-col-type="text" data-col-key="NormalizedEmail">Normalized Email</th>
<th class="portal-col" data-col-type="bool" data-col-key="EmailConfirmed">Email Confirmed</th>
<th class="portal-col" data-col-type="text" data-col-key="PhoneNumber">Phone Number</th>
<th class="portal-col" data-col-type="bool" data-col-key="PhoneNumberConfirmed">Phone Number Confirmed</th>
<th class="portal-col" data-col-type="bool" data-col-key="TwoFactorEnabled">Two Factor Enabled</th>
<th class="portal-col" data-col-type="text" data-col-key="LockoutEnd">Lockout End</th>
<th class="portal-col" data-col-type="bool" data-col-key="LockoutEnabled">Lockout Enabled</th>
<th class="portal-col" data-col-type="int" data-col-key="AccessFailedCount">Access Failed Count</th>
<th class="portal-col" data-col-type="thumb" data-col-key="PhotoUrl">Photo URL</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        @PortalOperationButtonsHtml.Cell(ops, item.GetKey(), areaName, controllerName)
                        <td class="portal-col" data-col-type="text" data-col-key="Id">@item.Id</td>
<td class="portal-col" data-col-type="text" data-col-key="FirstName">@item.FirstName</td>
<td class="portal-col" data-col-type="text" data-col-key="LastName">@item.LastName</td>
<td class="portal-col" data-col-type="fk" data-col-key="PermissionGroupName">			@string.Format("{0}", Model.GetComboBoxValue("PermissionGroups", item.PermissionGroupName))</td>
<td class="portal-col" data-col-type="text" data-col-key="UserName">@item.UserName</td>
<td class="portal-col" data-col-type="text" data-col-key="NormalizedUserName">@item.NormalizedUserName</td>
<td class="portal-col" data-col-type="text" data-col-key="Email">@item.Email</td>
<td class="portal-col" data-col-type="text" data-col-key="NormalizedEmail">@item.NormalizedEmail</td>
<td class="portal-col" data-col-type="bool" data-col-key="EmailConfirmed">@if (item.EmailConfirmed == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_EmailConfirmed" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_EmailConfirmed" disabled />
    </div>
}
</td>
<td class="portal-col" data-col-type="text" data-col-key="PhoneNumber">@item.PhoneNumber</td>
<td class="portal-col" data-col-type="bool" data-col-key="PhoneNumberConfirmed">@if (item.PhoneNumberConfirmed == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_PhoneNumberConfirmed" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_PhoneNumberConfirmed" disabled />
    </div>
}
</td>
<td class="portal-col" data-col-type="bool" data-col-key="TwoFactorEnabled">@if (item.TwoFactorEnabled == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_TwoFactorEnabled" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_TwoFactorEnabled" disabled />
    </div>
}
</td>
<td class="portal-col" data-col-type="text" data-col-key="LockoutEnd">@item.LockoutEnd</td>
<td class="portal-col" data-col-type="bool" data-col-key="LockoutEnabled">@if (item.LockoutEnabled == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_LockoutEnabled" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_LockoutEnabled" disabled />
    </div>
}
</td>
<td class="portal-col" data-col-type="int" data-col-key="AccessFailedCount">@(((object)item.AccessFailedCount).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="thumb" data-col-key="PhotoUrl"><a href="@(item.PhotoUrl == null || item.PhotoUrl.Length == 0 ? "/images/no_image.png" : item.PhotoUrl)" data-toggle="lightbox" data-type="image" class="portal-list-thumb-link">
   <img class="lazyload img-fluid" src="/images/loading.svg" data-src="@(item.PhotoUrl == null || item.PhotoUrl.Length == 0 ? "/images/no_image.png" : item.PhotoUrl)" style="height:auto;  width:auto; max-height: 110px; max-width: 110px;display: block;margin-left: auto;margin-right: auto;" bc-thumbnail="true" bc-round="true" />
</a>
</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
}
