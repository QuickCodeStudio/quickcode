@using QuickCode.QuickCode.Portal.Models.IdentityModule
@using QuickCode.QuickCode.Portal.Helpers
@inject IPortalPagePermissionManager PortalPagePermissions
@model IdentityModule.AuditLogData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex };
    var areaName = ViewContext.RouteData.Values["Area"]?.ToString() ?? string.Empty;
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;
    var actionName = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
    var ops = await PortalPagePermissions.GetPagePermission($"{areaName}{controllerName}", actionName);
}
@if (Model.List.Count == 0)
{
    <div class="alert alert-danger" role="alert">
        No Data available in IdentityModule.AuditLog table.
    </div>
}
else
{
    <vc:pager pager-data=pagerData></vc:pager>
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    @PortalOperationButtonsHtml.Cell(ops, "Header", areaName, controllerName)
                    <th class="portal-col" data-col-type="text" data-col-key="EntityName">Entity Name</th>
<th class="portal-col" data-col-type="text" data-col-key="EntityId">Entity ID</th>
<th class="portal-col" data-col-type="text" data-col-key="Action">Action</th>
<th class="portal-col" data-col-type="text" data-col-key="UserId">User ID</th>
<th class="portal-col" data-col-type="text" data-col-key="UserName">User Name</th>
<th class="portal-col" data-col-type="text" data-col-key="UserGroup">User Group</th>
<th class="portal-col" data-col-type="datetime" data-col-key="Timestamp">Timestamp</th>
<th class="portal-col" data-col-type="int" data-col-key="DurationMs">Duration Ms</th>
<th class="portal-col" data-col-type="int" data-col-key="StatusCode">Status Code</th>
<th class="portal-col" data-col-type="text" data-col-key="RequestModule">Request Module</th>
<th class="portal-col" data-col-type="text" data-col-key="RequestPath">Request Path</th>
<th class="portal-col" data-col-type="large" data-col-key="OldValues">Old Values</th>
<th class="portal-col" data-col-type="large" data-col-key="NewValues">New Values</th>
<th class="portal-col" data-col-type="large" data-col-key="ChangedColumns">Changed Columns</th>
<th class="portal-col" data-col-type="bool" data-col-key="IsChanged">Is Changed</th>
<th class="portal-col" data-col-type="large" data-col-key="ChangeSummary">Change Summary</th>
<th class="portal-col" data-col-type="text" data-col-key="IpAddress">IP Address</th>
<th class="portal-col" data-col-type="text" data-col-key="UserAgent">User Agent</th>
<th class="portal-col" data-col-type="text" data-col-key="CorrelationId">Correlation ID</th>
<th class="portal-col" data-col-type="bool" data-col-key="IsSuccess">Is Success</th>
<th class="portal-col" data-col-type="large" data-col-key="ErrorMessage">Error Message</th>
<th class="portal-col" data-col-type="text" data-col-key="Hash">Hash</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        @PortalOperationButtonsHtml.Cell(ops, item.GetKey(), areaName, controllerName)
                        <td class="portal-col" data-col-type="text" data-col-key="EntityName">@item.EntityName</td>
<td class="portal-col" data-col-type="text" data-col-key="EntityId">@item.EntityId</td>
<td class="portal-col" data-col-type="text" data-col-key="Action">@item.Action</td>
<td class="portal-col" data-col-type="text" data-col-key="UserId">@item.UserId</td>
<td class="portal-col" data-col-type="text" data-col-key="UserName">@item.UserName</td>
<td class="portal-col" data-col-type="text" data-col-key="UserGroup">@item.UserGroup</td>
<td class="portal-col" data-col-type="datetime" data-col-key="Timestamp">@(((object)item.Timestamp).ToPortalGridDateTime())</td>
<td class="portal-col" data-col-type="int" data-col-key="DurationMs">@(((object)item.DurationMs).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="int" data-col-key="StatusCode">@(((object)item.StatusCode).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="text" data-col-key="RequestModule">@item.RequestModule</td>
<td class="portal-col" data-col-type="text" data-col-key="RequestPath">@item.RequestPath</td>
<td class="portal-col" data-col-type="large" data-col-key="OldValues">@item.OldValues</td>
<td class="portal-col" data-col-type="large" data-col-key="NewValues">@item.NewValues</td>
<td class="portal-col" data-col-type="large" data-col-key="ChangedColumns">@item.ChangedColumns</td>
<td class="portal-col" data-col-type="bool" data-col-key="IsChanged">@if (item.IsChanged == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsChanged" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsChanged" disabled />
    </div>
}
</td>
<td class="portal-col" data-col-type="large" data-col-key="ChangeSummary">@item.ChangeSummary</td>
<td class="portal-col" data-col-type="text" data-col-key="IpAddress">@item.IpAddress</td>
<td class="portal-col" data-col-type="text" data-col-key="UserAgent">@item.UserAgent</td>
<td class="portal-col" data-col-type="text" data-col-key="CorrelationId">@item.CorrelationId</td>
<td class="portal-col" data-col-type="bool" data-col-key="IsSuccess">@if (item.IsSuccess == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsSuccess" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsSuccess" disabled />
    </div>
}
</td>
<td class="portal-col" data-col-type="large" data-col-key="ErrorMessage">@item.ErrorMessage</td>
<td class="portal-col" data-col-type="text" data-col-key="Hash">@item.Hash</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
}
