@model QuickCode.QuickCode.Portal.Models.QuickCodeModule.AuditLogGetRecentHttpRequestsByModuleData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    if (startIndex < 1) { startIndex = 1; }
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData()
    {
        CurrentPage = Model.CurrentPage,
        NumberOfRecord = Model.NumberOfRecord,
        PageSize = Model.PageSize,
        TotalPage = Model.TotalPage,
        StartIndex = startIndex,
        EndIndex = endIndex,
        HasMoreRecords = Model.HasMoreRecords,
        RecordNounSingular = "row",
        RecordNounPlural = "rows"
    };
    var resultCount = Model.List?.Count ?? 0;
    var hasPager = true;
}
@* Always present so Endpoint modal can show Response fields before the report is run. *@
<script type="application/json" id="portalQueryResponseSchema" data-response-type="List<GetRecentHttpRequestsByModuleResponseDto>">[{"name":"id","type":"Guid","description":"ID \u2014 field on the response DTO."},{"name":"timestamp","type":"DateTime","description":"Timestamp \u2014 field on the response DTO."},{"name":"durationMs","type":"int","description":"Duration Ms \u2014 field on the response DTO."},{"name":"statusCode","type":"int","description":"Status Code \u2014 field on the response DTO."},{"name":"requestModule","type":"string","description":"Request Module \u2014 field on the response DTO."},{"name":"action","type":"string","description":"Action \u2014 field on the response DTO."},{"name":"userGroup","type":"string","description":"User Group \u2014 field on the response DTO."},{"name":"isSuccess","type":"bool","description":"Is Success \u2014 field on the response DTO."},{"name":"errorMessage","type":"string","description":"Error Message \u2014 field on the response DTO."},{"name":"newValues","type":"string","description":"New Values \u2014 field on the response DTO."}]</script>
@if (!Model.HasRun)
{
    <div class="portal-query-empty portal-query-empty--idle" role="status">
        <span class="portal-query-empty__title">Ready to run</span>
        <span class="portal-query-empty__text">Choose parameters, then hit <strong>Run Report</strong>.</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    var isNotFound = Model.QueryHttpStatus == 404;
    var emptyClass = isNotFound ? "portal-query-empty--empty" : "portal-query-empty--error";
    var title = isNotFound ? "No rows matched" : "Request failed";
    <div class="portal-query-empty @emptyClass" role="@(isNotFound ? "status" : "alert")">
        <div class="portal-query-empty__header">
            <span class="portal-query-empty__title">@title</span>
            @if (Model.QueryHttpStatus.HasValue)
            {
                <span class="portal-query-empty__status">HTTP @Model.QueryHttpStatus</span>
            }
        </div>
        <span class="portal-query-empty__text">@Model.ErrorMessage</span>
    </div>
}
else if (Model.List == null || Model.List.Count == 0)
{
    <div class="portal-query-empty portal-query-empty--empty" role="status">
        <span class="portal-query-empty__title">No rows matched</span>
        <span class="portal-query-empty__text">Nothing came back for the current parameters.</span>
    </div>
}
else
{
    <vc:pager pager-data=pagerData></vc:pager>
@if (!hasPager)
{
    <div class="portal-list-pager">
        <div class="portal-list-pager__cluster">
            <div class="portal-list-pager__range" aria-live="polite">
                <span class="portal-list-pager__range-strong">@resultCount.ToString("N0")</span>
                <span class="portal-list-pager__range-muted">@(resultCount == 1 ? "row" : "rows")</span>
            </div>
        </div>
    </div>
}
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    <th class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">#</th>
                                        <th class="portal-col" data-col-type="guid" data-col-key="Id">ID</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="Timestamp">Timestamp</th>
                    <th class="portal-col" data-col-type="int" data-col-key="DurationMs">Duration Ms</th>
                    <th class="portal-col" data-col-type="int" data-col-key="StatusCode">Status Code</th>
                    <th class="portal-col" data-col-type="text" data-col-key="RequestModule">Request Module</th>
                    <th class="portal-col" data-col-type="text" data-col-key="Action">Action</th>
                    <th class="portal-col" data-col-type="text" data-col-key="UserGroup">User Group</th>
                    <th class="portal-col" data-col-type="bool" data-col-key="IsSuccess">Is Success</th>
                    <th class="portal-col" data-col-type="large" data-col-key="ErrorMessage">Error Message</th>
                    <th class="portal-col" data-col-type="large" data-col-key="NewValues">New Values</th>
                </tr>
            </thead>
            <tbody>
@{
    var rowNo = startIndex;
}
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">@rowNo</td>
                                                <td class="portal-col" data-col-type="guid" data-col-key="Id">@item.Id</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="Timestamp">@(((object)item.Timestamp).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="int" data-col-key="DurationMs">@(((object)item.DurationMs).ToPortalGridInt())</td>
                        <td class="portal-col" data-col-type="int" data-col-key="StatusCode">@(((object)item.StatusCode).ToPortalGridInt())</td>
                        <td class="portal-col" data-col-type="text" data-col-key="RequestModule">@item.RequestModule</td>
                        <td class="portal-col" data-col-type="text" data-col-key="Action">@item.Action</td>
                        <td class="portal-col" data-col-type="text" data-col-key="UserGroup">@item.UserGroup</td>
                        <td class="portal-col" data-col-type="bool" data-col-key="IsSuccess">@item.IsSuccess</td>
                        <td class="portal-col" data-col-type="large" data-col-key="ErrorMessage">@item.ErrorMessage</td>
                        <td class="portal-col" data-col-type="large" data-col-key="NewValues">@item.NewValues</td>
                    </tr>
                    rowNo++;
                }
            </tbody>
        </table>
    </div>
}
