@using QuickCode.QuickCode.Portal.Models.QuickCodeModule
@using QuickCode.QuickCode.Portal.Helpers
@inject IPortalPagePermissionManager PortalPagePermissions
@model QuickCodeModule.GenerationActionData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex };
    var areaName = ViewContext.RouteData.Values["Area"]?.ToString() ?? string.Empty;
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;
    var actionName = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
    var ops = await PortalPagePermissions.GetPagePermission($"{areaName}{controllerName}", actionName);
}
@if (Model.List.Count == 0)
{
    <div class="alert alert-danger" role="alert">
        No Data available in QuickCodeModule.GenerationAction table.
    </div>
}
else
{
    <vc:pager pager-data=pagerData></vc:pager>
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    @PortalOperationButtonsHtml.Cell(ops, "Header", areaName, controllerName)
                    <th class="portal-col" data-col-type="id" data-col-key="Id">ID</th>
<th class="portal-col" data-col-type="fk" data-col-key="ProjectId">Project ID</th>
<th class="portal-col" data-col-type="fk" data-col-key="GenerationRunId">Generation Run ID</th>
<th class="portal-col" data-col-type="fk" data-col-key="GenerationStepId">Generation Step ID</th>
<th class="portal-col" data-col-type="large" data-col-key="StepParameters">Step Parameters</th>
<th class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">Created Date</th>
<th class="portal-col" data-col-type="datetime" data-col-key="StartDate">Start Date</th>
<th class="portal-col" data-col-type="datetime" data-col-key="EndDate">End Date</th>
<th class="portal-col" data-col-type="int" data-col-key="ElapsedTime">Elapsed Time</th>
<th class="portal-col" data-col-type="large" data-col-key="OutputMessage">Output Message</th>
<th class="portal-col" data-col-type="bool" data-col-key="IsCompleted">Is Completed</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        @PortalOperationButtonsHtml.Cell(ops, item.GetKey(), areaName, controllerName)
                        <td class="portal-col" data-col-type="id" data-col-key="Id">@item.Id</td>
<td class="portal-col" data-col-type="fk" data-col-key="ProjectId">			@string.Format("{0}", Model.GetComboBoxValue("Projects", item.ProjectId))</td>
<td class="portal-col" data-col-type="fk" data-col-key="GenerationRunId">			@string.Format("{0}", Model.GetComboBoxValue("GenerationRuns", item.GenerationRunId))</td>
<td class="portal-col" data-col-type="fk" data-col-key="GenerationStepId">			@string.Format("{0}", Model.GetComboBoxValue("GenerationSteps", item.GenerationStepId))</td>
<td class="portal-col" data-col-type="large" data-col-key="StepParameters">@item.StepParameters</td>
<td class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">@(((object)item.CreatedDate).ToPortalGridDateTime())</td>
<td class="portal-col" data-col-type="datetime" data-col-key="StartDate">@(((object)item.StartDate).ToPortalGridDateTime())</td>
<td class="portal-col" data-col-type="datetime" data-col-key="EndDate">@(((object)item.EndDate).ToPortalGridDateTime())</td>
<td class="portal-col" data-col-type="int" data-col-key="ElapsedTime">@(((object)item.ElapsedTime).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="large" data-col-key="OutputMessage">@item.OutputMessage</td>
<td class="portal-col" data-col-type="bool" data-col-key="IsCompleted">@if (item.IsCompleted == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsCompleted" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsCompleted" disabled />
    </div>
}
</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
}
