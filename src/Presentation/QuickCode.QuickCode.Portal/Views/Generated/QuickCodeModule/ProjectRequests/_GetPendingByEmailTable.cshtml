@model QuickCode.QuickCode.Portal.Models.QuickCodeModule.ProjectRequestGetPendingByEmailData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    if (startIndex < 1) { startIndex = 1; }
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData()
    {
        CurrentPage = Model.CurrentPage,
        NumberOfRecord = Model.NumberOfRecord,
        PageSize = Model.PageSize,
        TotalPage = Model.TotalPage,
        StartIndex = startIndex,
        EndIndex = endIndex,
        HasMoreRecords = Model.HasMoreRecords,
        RecordNounSingular = "row",
        RecordNounPlural = "rows"
    };
    var resultCount = Model.List?.Count ?? 0;
    var hasPager = false;
}
@* Always present so Endpoint modal can show Response fields before the report is run. *@
<script type="application/json" id="portalQueryResponseSchema" data-response-type="List<GetPendingByEmailResponseDto>">[{"name":"id","type":"Guid","description":"ID \u2014 field on the response DTO."},{"name":"projectName","type":"string","description":"Project Name \u2014 field on the response DTO."},{"name":"email","type":"string","description":"Email \u2014 field on the response DTO."},{"name":"prompt","type":"string","description":"Prompt \u2014 field on the response DTO."},{"name":"provider","type":"string","description":"Provider \u2014 field on the response DTO."},{"name":"documentStorageKey","type":"string","description":"Document Storage Key \u2014 field on the response DTO."},{"name":"documentFileName","type":"string","description":"Document File Name \u2014 field on the response DTO."},{"name":"tokenHash","type":"string","description":"Token Hash \u2014 field on the response DTO."},{"name":"expiresAt","type":"DateTime","description":"Expires At \u2014 field on the response DTO."},{"name":"status","type":"ProjectRequestStatus","description":"Status \u2014 field on the response DTO."},{"name":"resendCount","type":"int","description":"Resend Count \u2014 field on the response DTO."},{"name":"confirmedAt","type":"DateTime","description":"Confirmed At \u2014 field on the response DTO."},{"name":"projectId","type":"Guid","description":"Project ID \u2014 field on the response DTO."},{"name":"createdDate","type":"DateTime","description":"Created Date \u2014 field on the response DTO."},{"name":"updatedDate","type":"DateTime","description":"Updated Date \u2014 field on the response DTO."}]</script>
@if (!Model.HasRun)
{
    <div class="portal-query-empty portal-query-empty--idle" role="status">
        <span class="portal-query-empty__title">Ready to run</span>
        <span class="portal-query-empty__text">Choose parameters, then hit <strong>Run Report</strong>.</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    var isNotFound = Model.QueryHttpStatus == 404;
    var emptyClass = isNotFound ? "portal-query-empty--empty" : "portal-query-empty--error";
    var title = isNotFound ? "No rows matched" : "Request failed";
    <div class="portal-query-empty @emptyClass" role="@(isNotFound ? "status" : "alert")">
        <div class="portal-query-empty__header">
            <span class="portal-query-empty__title">@title</span>
            @if (Model.QueryHttpStatus.HasValue)
            {
                <span class="portal-query-empty__status">HTTP @Model.QueryHttpStatus</span>
            }
        </div>
        <span class="portal-query-empty__text">@Model.ErrorMessage</span>
    </div>
}
else if (Model.List == null || Model.List.Count == 0)
{
    <div class="portal-query-empty portal-query-empty--empty" role="status">
        <span class="portal-query-empty__title">No rows matched</span>
        <span class="portal-query-empty__text">Nothing came back for the current parameters.</span>
    </div>
}
else
{

@if (!hasPager)
{
    <div class="portal-list-pager">
        <div class="portal-list-pager__cluster">
            <div class="portal-list-pager__range" aria-live="polite">
                <span class="portal-list-pager__range-strong">@resultCount.ToString("N0")</span>
                <span class="portal-list-pager__range-muted">@(resultCount == 1 ? "row" : "rows")</span>
            </div>
        </div>
    </div>
}
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    <th class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">#</th>
                                        <th class="portal-col" data-col-type="guid" data-col-key="Id">ID</th>
                    <th class="portal-col" data-col-type="text" data-col-key="ProjectName">Project Name</th>
                    <th class="portal-col" data-col-type="email" data-col-key="Email">Email</th>
                    <th class="portal-col" data-col-type="large" data-col-key="Prompt">Prompt</th>
                    <th class="portal-col" data-col-type="text" data-col-key="Provider">Provider</th>
                    <th class="portal-col" data-col-type="text" data-col-key="DocumentStorageKey">Document Storage Key</th>
                    <th class="portal-col" data-col-type="text" data-col-key="DocumentFileName">Document File Name</th>
                    <th class="portal-col" data-col-type="text" data-col-key="TokenHash">Token Hash</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="ExpiresAt">Expires At</th>
                    <th class="portal-col" data-col-type="text" data-col-key="Status">Status</th>
                    <th class="portal-col" data-col-type="int" data-col-key="ResendCount">Resend Count</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="ConfirmedAt">Confirmed At</th>
                    <th class="portal-col" data-col-type="guid" data-col-key="ProjectId">Project ID</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">Created Date</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="UpdatedDate">Updated Date</th>
                </tr>
            </thead>
            <tbody>
@{
    var rowNo = startIndex;
}
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">@rowNo</td>
                                                <td class="portal-col" data-col-type="guid" data-col-key="Id">@item.Id</td>
                        <td class="portal-col" data-col-type="text" data-col-key="ProjectName">@item.ProjectName</td>
                        <td class="portal-col" data-col-type="email" data-col-key="Email">@item.Email</td>
                        <td class="portal-col" data-col-type="large" data-col-key="Prompt">@item.Prompt</td>
                        <td class="portal-col" data-col-type="text" data-col-key="Provider">@item.Provider</td>
                        <td class="portal-col" data-col-type="text" data-col-key="DocumentStorageKey">@item.DocumentStorageKey</td>
                        <td class="portal-col" data-col-type="text" data-col-key="DocumentFileName">@item.DocumentFileName</td>
                        <td class="portal-col" data-col-type="text" data-col-key="TokenHash">@item.TokenHash</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="ExpiresAt">@(((object)item.ExpiresAt).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="text" data-col-key="Status">@item.Status</td>
                        <td class="portal-col" data-col-type="int" data-col-key="ResendCount">@(((object)item.ResendCount).ToPortalGridInt())</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="ConfirmedAt">@(((object)item.ConfirmedAt).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="guid" data-col-key="ProjectId">@item.ProjectId</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">@(((object)item.CreatedDate).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="UpdatedDate">@(((object)item.UpdatedDate).ToPortalGridDateTime())</td>
                    </tr>
                    rowNo++;
                }
            </tbody>
        </table>
    </div>
}
