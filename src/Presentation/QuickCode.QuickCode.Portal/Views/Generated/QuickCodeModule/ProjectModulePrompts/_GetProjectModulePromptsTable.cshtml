@model QuickCode.QuickCode.Portal.Models.QuickCodeModule.ProjectModulePromptGetProjectModulePromptsData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    if (startIndex < 1) { startIndex = 1; }
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData()
    {
        CurrentPage = Model.CurrentPage,
        NumberOfRecord = Model.NumberOfRecord,
        PageSize = Model.PageSize,
        TotalPage = Model.TotalPage,
        StartIndex = startIndex,
        EndIndex = endIndex,
        HasMoreRecords = Model.HasMoreRecords,
        RecordNounSingular = "row",
        RecordNounPlural = "rows"
    };
    var resultCount = Model.List?.Count ?? 0;
    var hasPager = false;
}
@* Always present so Endpoint modal can show Response fields before the report is run. *@
<script type="application/json" id="portalQueryResponseSchema" data-response-type="List<GetProjectModulePromptsResponseDto>">[{"name":"id","type":"int","description":"ID \u2014 field on the response DTO."},{"name":"projectId","type":"Guid","description":"Project ID \u2014 field on the response DTO."},{"name":"moduleName","type":"string","description":"Module Name \u2014 field on the response DTO."},{"name":"aiType","type":"string","description":"AI Type \u2014 field on the response DTO."},{"name":"userPrompt","type":"string","description":"User Prompt \u2014 field on the response DTO."},{"name":"systemPrompt","type":"string","description":"System Prompt \u2014 field on the response DTO."},{"name":"aiResponse","type":"string","description":"AI Response \u2014 field on the response DTO."},{"name":"createdDate","type":"DateTime","description":"Created Date \u2014 field on the response DTO."},{"name":"updatedDate","type":"DateTime","description":"Updated Date \u2014 field on the response DTO."}]</script>
@if (!Model.HasRun)
{
    <div class="portal-query-empty portal-query-empty--idle" role="status">
        <span class="portal-query-empty__title">Ready to run</span>
        <span class="portal-query-empty__text">Choose parameters, then hit <strong>Run Report</strong>.</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    var isNotFound = Model.QueryHttpStatus == 404;
    var emptyClass = isNotFound ? "portal-query-empty--empty" : "portal-query-empty--error";
    var title = isNotFound ? "No rows matched" : "Request failed";
    <div class="portal-query-empty @emptyClass" role="@(isNotFound ? "status" : "alert")">
        <div class="portal-query-empty__header">
            <span class="portal-query-empty__title">@title</span>
            @if (Model.QueryHttpStatus.HasValue)
            {
                <span class="portal-query-empty__status">HTTP @Model.QueryHttpStatus</span>
            }
        </div>
        <span class="portal-query-empty__text">@Model.ErrorMessage</span>
    </div>
}
else if (Model.List == null || Model.List.Count == 0)
{
    <div class="portal-query-empty portal-query-empty--empty" role="status">
        <span class="portal-query-empty__title">No rows matched</span>
        <span class="portal-query-empty__text">Nothing came back for the current parameters.</span>
    </div>
}
else
{

@if (!hasPager)
{
    <div class="portal-list-pager">
        <div class="portal-list-pager__cluster">
            <div class="portal-list-pager__range" aria-live="polite">
                <span class="portal-list-pager__range-strong">@resultCount.ToString("N0")</span>
                <span class="portal-list-pager__range-muted">@(resultCount == 1 ? "row" : "rows")</span>
            </div>
        </div>
    </div>
}
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    <th class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">#</th>
                                        <th class="portal-col" data-col-type="int" data-col-key="Id">ID</th>
                    <th class="portal-col" data-col-type="guid" data-col-key="ProjectId">Project ID</th>
                    <th class="portal-col" data-col-type="text" data-col-key="ModuleName">Module Name</th>
                    <th class="portal-col" data-col-type="text" data-col-key="AiType">AI Type</th>
                    <th class="portal-col" data-col-type="large" data-col-key="UserPrompt">User Prompt</th>
                    <th class="portal-col" data-col-type="large" data-col-key="SystemPrompt">System Prompt</th>
                    <th class="portal-col" data-col-type="large" data-col-key="AiResponse">AI Response</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">Created Date</th>
                    <th class="portal-col" data-col-type="datetime" data-col-key="UpdatedDate">Updated Date</th>
                </tr>
            </thead>
            <tbody>
@{
    var rowNo = startIndex;
}
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td class="portal-col portal-query-rownum" data-col-type="int" data-col-key="__row">@rowNo</td>
                                                <td class="portal-col" data-col-type="int" data-col-key="Id">@(((object)item.Id).ToPortalGridInt())</td>
                        <td class="portal-col" data-col-type="guid" data-col-key="ProjectId">@item.ProjectId</td>
                        <td class="portal-col" data-col-type="text" data-col-key="ModuleName">@item.ModuleName</td>
                        <td class="portal-col" data-col-type="text" data-col-key="AiType">@item.AiType</td>
                        <td class="portal-col" data-col-type="large" data-col-key="UserPrompt">@item.UserPrompt</td>
                        <td class="portal-col" data-col-type="large" data-col-key="SystemPrompt">@item.SystemPrompt</td>
                        <td class="portal-col" data-col-type="large" data-col-key="AiResponse">@item.AiResponse</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">@(((object)item.CreatedDate).ToPortalGridDateTime())</td>
                        <td class="portal-col" data-col-type="datetime" data-col-key="UpdatedDate">@(((object)item.UpdatedDate).ToPortalGridDateTime())</td>
                    </tr>
                    rowNo++;
                }
            </tbody>
        </table>
    </div>
}
