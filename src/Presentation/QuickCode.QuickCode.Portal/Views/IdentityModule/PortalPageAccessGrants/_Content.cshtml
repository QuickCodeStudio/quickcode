@model GetPortalPageAccessGrantData
@using System.Collections.Generic
@using System.Linq
@using QuickCode.QuickCode.Portal.Helpers
@using QuickCode.QuickCode.Infrastructure.Integration.Nswag.Clients.IdentityModuleApi.Contracts
@{
    var view = PortalPermissionGroupViewHelper.Build(Model.Items?.PortalPageDefinitions);
    var pageModuleIndex = 0;
    var queryModuleIndex = 0;
}
<div class="pgp" id="pgpRoot">
    <div class="pgp-tabs" role="tablist" aria-label="Permission categories">
        <button type="button" class="pgp-tab is-active" role="tab" aria-selected="true" data-tab="pages" id="pgpTabPages">
            <i class="fas fa-table" aria-hidden="true"></i>
            Pages
            <span class="pgp-tab-count">@view.PageItemCount</span>
        </button>
        <button type="button" class="pgp-tab" role="tab" aria-selected="false" data-tab="queries" id="pgpTabQueries">
            <i class="fas fa-chart-bar" aria-hidden="true"></i>
            Live Reports
            <span class="pgp-tab-count">@view.QueryItemCount</span>
        </button>
    </div>

    <div class="pgp-panel" data-panel="pages" role="tabpanel" aria-labelledby="pgpTabPages">
        @if (view.PageItemCount == 0)
        {
            <div class="pgp-empty">No CRUD pages found for this permission group.</div>
        }
        else
        {
            @foreach (var module in view.PageModules)
            {
                pageModuleIndex++;
                var moduleId = $"pgpPageMod{module.ModuleName}".Replace(" ", "").Replace(".", "");
                <div class="pgp-module searchable-module @(pageModuleIndex == 1 ? "is-open" : "")" data-kind="pages" data-module="@module.ModuleName">
                    <div class="pgp-module-header" role="button" tabindex="0" data-pgp-toggle="module" aria-expanded="@(pageModuleIndex == 1 ? "true" : "false")">
                        <span class="pgp-module-title">
                            <i class="fas fa-chevron-right pgp-chevron" aria-hidden="true"></i>
                            <i class="fas fa-cube" aria-hidden="true"></i>
                            @module.ModuleName.SplitCamelCaseToString()
                        </span>
                        <span class="pgp-module-meta module-count-badge" data-total="@module.Items.Count">@module.Items.Count pages</span>
                    </div>
                    <div class="pgp-module-body" id="@moduleId">
                        <div class="pgp-pages-grid searchable-cards-container">
                            @foreach (var item in module.Items)
                            {
                                var displayName = (item.TableName ?? item.ModelName ?? "").SplitCamelCaseToString();
                                <div class="pgp-page-card searchable-card"
                                     data-module="@module.ModuleName"
                                     data-page="@displayName.ToLowerInvariant()"
                                     data-page-label="@displayName"
                                     data-kind="pages">
                                    <div class="pgp-page-head">
                                        <small class="pgp-field-label">Page Name:</small>
                                        <div class="pgp-page-name">@displayName</div>
                                    </div>
                                    <div class="pgp-page-perms-block">
                                        <small class="pgp-field-label">Permissions:</small>
                                        <div class="pgp-page-perms">
                                            @foreach (var itemType in item.PortalPagePermissionTypes)
                                            {
                                                var permissionTypeName = itemType.PortalPagePermissionType.ToString();
                                                var checkboxId = $"cbox_{Model.Items.PermissionGroupName}_{item.PortalPagePermissionName}_{permissionTypeName}";
                                                <div class="pgp-perm">
                                                    <label class="pgp-perm-label" for="@checkboxId">@permissionTypeName</label>
                                                    <div class="ios-switch-wrapper @(itemType.Value ? "checked" : "")">
                                                        @if (itemType.Value)
                                                        {
                                                            <input class="ios-switch" type="checkbox" id="@checkboxId" checked />
                                                        }
                                                        else
                                                        {
                                                            <input class="ios-switch" type="checkbox" id="@checkboxId" />
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="pgp-panel" data-panel="queries" role="tabpanel" aria-labelledby="pgpTabQueries" hidden>
        <div class="pgp-breadcrumb-hint">
            <span class="pgp-crumb">Live Reports</span>
            <span class="pgp-crumb-sep" aria-hidden="true">/</span>
            <span>Module</span>
            <span class="pgp-crumb-sep" aria-hidden="true">/</span>
            <span>Tables</span>
            <span class="pgp-crumb-sep" aria-hidden="true">/</span>
            <span>Report page</span>
        </div>

        @if (view.QueryItemCount == 0)
        {
            <div class="pgp-empty">No live report pages found for this permission group.</div>
        }
        else
        {
            @foreach (var module in view.QueryModules)
            {
                queryModuleIndex++;
                var moduleId = $"pgpQueryMod{module.ModuleName}".Replace(" ", "").Replace(".", "");
                var moduleLabel = module.ModuleName.SplitCamelCaseToString();
                <div class="pgp-module searchable-module @(queryModuleIndex == 1 ? "is-open" : "")" data-kind="queries" data-module="@module.ModuleName">
                    <div class="pgp-module-header" role="button" tabindex="0" data-pgp-toggle="module" aria-expanded="@(queryModuleIndex == 1 ? "true" : "false")">
                        <span class="pgp-module-title">
                            <i class="fas fa-chevron-right pgp-chevron" aria-hidden="true"></i>
                            <i class="fas fa-layer-group" aria-hidden="true"></i>
                            @moduleLabel
                        </span>
                        <span class="pgp-module-meta module-count-badge" data-total="@module.QueryCount">@module.QueryCount reports · @module.Tables.Count tables</span>
                    </div>
                    <div class="pgp-module-body" id="@moduleId">
                        <div class="pgp-tree">
                            @{
                                var tableIndex = 0;
                            }
                            @foreach (var table in module.Tables)
                            {
                                tableIndex++;
                                var tableLabel = table.TableName.SplitCamelCaseToString();
                                var tableOpen = queryModuleIndex == 1 && tableIndex == 1;
                                var tableId = $"pgpTbl{module.ModuleName}{table.TableName}".Replace(" ", "").Replace(".", "");
                                <section class="pgp-table-group @(tableOpen ? "is-open" : "")" data-table="@table.TableName">
                                    <div class="pgp-table-header" role="button" tabindex="0" data-pgp-toggle="table" aria-expanded="@(tableOpen ? "true" : "false")" aria-controls="@tableId">
                                        <span class="pgp-table-title">
                                            <i class="fas fa-chevron-right pgp-chevron" aria-hidden="true"></i>
                                            <span class="pgp-table-icon" aria-hidden="true"><i class="fas fa-table"></i></span>
                                            <span class="pgp-table-text">@tableLabel</span>
                                        </span>
                                        <span class="pgp-table-count">@table.Items.Count</span>
                                    </div>
                                    <div class="pgp-query-list searchable-cards-container" id="@tableId">
                                        @foreach (var item in table.Items)
                                        {
                                            var queryLabel = (item.QueryName ?? item.ModelName ?? "").SplitCamelCaseToString();
                                            var endpointName = item.QueryName ?? item.ModelName ?? "";
                                            var endpointPath = item.PagePath ?? "";
                                            var listPerm = item.PortalPagePermissionTypes?.FirstOrDefault();
                                            var permissionTypeName = listPerm?.PortalPagePermissionType.ToString() ?? "List";
                                            var checkboxId = $"cbox_{Model.Items.PermissionGroupName}_{item.PortalPagePermissionName}_{permissionTypeName}";
                                            var granted = listPerm?.Value == true;
                                            <div class="pgp-query-row searchable-card"
                                                 data-module="@module.ModuleName"
                                                 data-table="@tableLabel.ToLowerInvariant()"
                                                 data-page="@queryLabel.ToLowerInvariant()"
                                                 data-page-label="@queryLabel"
                                                 data-endpoint="@endpointName.ToLowerInvariant()"
                                                 data-path="@endpointPath.ToLowerInvariant()"
                                                 data-kind="queries">
                                                <div class="pgp-query-info">
                                                    <span class="pgp-query-name">@queryLabel</span>
                                                    <span class="pgp-query-endpoint" title="@endpointPath">
                                                        <span class="pgp-endpoint-label">Endpoint</span>
                                                        <code class="pgp-endpoint-code">@(string.IsNullOrWhiteSpace(endpointPath) ? endpointName : endpointPath)</code>
                                                    </span>
                                                    <span class="pgp-query-path">@moduleLabel / @tableLabel / @queryLabel</span>
                                                </div>
                                                <div class="pgp-perm">
                                                    <span class="pgp-perm-label">Access</span>
                                                    <div class="ios-switch-wrapper @(granted ? "checked" : "")">
                                                        @if (granted)
                                                        {
                                                            <input class="ios-switch" type="checkbox" id="@checkboxId" checked />
                                                        }
                                                        else
                                                        {
                                                            <input class="ios-switch" type="checkbox" id="@checkboxId" />
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
