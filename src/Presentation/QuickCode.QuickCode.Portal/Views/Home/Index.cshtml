@model QuickCode.QuickCode.Portal.Models.DashboardStatsViewModel
@functions {
    private static string ModuleOptionValue(string moduleName)
    {
        if (string.IsNullOrWhiteSpace(moduleName) ||
            string.Equals(moduleName.Trim(), "All Modules", StringComparison.OrdinalIgnoreCase))
            return "All Modules";

        var normalized = moduleName.Trim()
            .Replace("_", " ")
            .Replace("-", " ");
        normalized = string.Join(" ", normalized.Split(' ', StringSplitOptions.RemoveEmptyEntries));

        if (normalized.EndsWith(" Module", StringComparison.OrdinalIgnoreCase))
            normalized = normalized[..^7];
        else if (normalized.EndsWith("Module", StringComparison.OrdinalIgnoreCase))
            normalized = normalized[..^6];

        var key = normalized.Trim().ToLowerInvariant().Replace(" ", "-");
        return string.IsNullOrWhiteSpace(key) ? "All Modules" : $"{key}-module";
    }
}
<style>
    .portal-dashboard {
        --dashboard-radius: 0.875rem; /* 14px — shared by all dashboard surfaces */
        /* 16px card gap — common admin/SaaS density (Material / Ant / BS g-3) */
        --dashboard-gap: 1rem;
    }

    .portal-dashboard .card {
        border-radius: var(--dashboard-radius) !important;
        overflow: hidden;
    }

    .portal-dashboard > .row {
        --bs-gutter-x: var(--dashboard-gap);
    }

    .portal-dashboard > .row > [class*="col-"] {
        margin-bottom: var(--dashboard-gap) !important;
    }

    .dashboard-data-card {
        border: 1px solid #e8edf3;
        border-radius: var(--dashboard-radius);
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        background: #fff;
        --dashboard-table-header-h: 2.4rem;
        --dashboard-table-row-h: 2.65rem;
    }

    .dashboard-data-card > .card-header {
        background: transparent;
        border-bottom: 1px solid #f1f5f9;
        padding: 1rem 1.15rem .85rem;
    }

    .dashboard-data-card > .card-header h6 {
        margin: 0;
        font-size: .95rem;
        font-weight: 700;
        letter-spacing: -.02em;
        color: #0f172a;
    }

    .dashboard-data-card > .card-header .card-subtitle {
        margin-top: .2rem;
        font-size: .78rem;
        color: #64748b;
        font-weight: 500;
    }

    .dashboard-data-card > .card-body {
        padding: .35rem .55rem .7rem;
    }

    .dashboard-table-scroll {
        max-height: 300px;
        overflow-y: auto;
        padding-bottom: 1px;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

    .dashboard-table-scroll::-webkit-scrollbar {
        width: 6px;
    }

    .dashboard-table-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 999px;
    }

    .dashboard-modern-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: .8125rem;
        color: #334155;
    }

    .dashboard-daily-details-scroll {
        /* Header + exactly 7 body rows (last 7 days). */
        height: calc(var(--dashboard-table-header-h) + (7 * var(--dashboard-table-row-h)));
        max-height: calc(var(--dashboard-table-header-h) + (7 * var(--dashboard-table-row-h)));
        overflow-y: auto;
    }

    .dashboard-modern-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        height: var(--dashboard-table-header-h);
        box-sizing: border-box;
        padding: 0 .85rem;
        border: 0;
        border-bottom: 1px solid #e8edf3;
        background: rgba(255, 255, 255, .92);
        backdrop-filter: blur(6px);
        color: #64748b;
        font-size: .68rem;
        font-weight: 650;
        letter-spacing: .04em;
        text-transform: uppercase;
        white-space: nowrap;
        vertical-align: middle;
    }

    .dashboard-modern-table tbody td {
        height: var(--dashboard-table-row-h);
        box-sizing: border-box;
        padding: 0 .85rem;
        border: 0;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        background: transparent;
    }

    .dashboard-modern-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .dashboard-modern-table tbody tr {
        transition: background .12s ease;
    }

    .dashboard-modern-table tbody tr:hover td {
        background: #f8fafc;
    }

    .dashboard-modern-table .col-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        color: #0f172a;
        white-space: nowrap;
    }

    .dashboard-modern-table .col-day {
        font-weight: 600;
        color: #0f172a;
        white-space: nowrap;
    }

    .dashboard-modern-table .col-muted {
        color: #64748b;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .dashboard-modern-table .col-module {
        font-weight: 600;
        color: #1e293b;
        white-space: nowrap;
    }

    .dashboard-method {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 3.1rem;
        padding: .18rem .45rem;
        margin-right: .4rem;
        border-radius: 6px;
        font-size: .65rem;
        font-weight: 700;
        letter-spacing: .03em;
        line-height: 1.2;
        vertical-align: middle;
    }

    .dashboard-method.is-get { color: #0369a1; background: #e0f2fe; }
    .dashboard-method.is-post { color: #047857; background: #d1fae5; }
    .dashboard-method.is-put { color: #b45309; background: #ffedd5; }
    .dashboard-method.is-patch { color: #a16207; background: #fef9c3; }
    .dashboard-method.is-delete { color: #b91c1c; background: #fee2e2; }
    .dashboard-method.is-other { color: #475569; background: #e2e8f0; }

    .dashboard-service-path {
        color: #475569;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: .78rem;
    }

    .dashboard-req-cell {
        min-width: 5.5rem;
    }

    .dashboard-req-bar {
        display: block;
        height: 4px;
        margin-top: .35rem;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
    }

    .dashboard-req-bar > span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #4e73df, #36b9cc);
    }

    .dashboard-table-empty {
        padding: 1.75rem 1rem;
        text-align: center;
        color: #94a3b8;
        font-size: .85rem;
    }

    .dashboard-filter {
        min-width: 260px;
        height: calc(1.5em + .75rem + 2px);
        border-color: #d1d3e2;
        color: #6e707e;
        box-shadow: none;
        cursor: pointer;
    }

    .dashboard-filter:focus {
        border-color: #bac8f3;
        box-shadow: 0 0 0 .2rem rgba(78, 115, 223, .15);
    }

    .dashboard-filter-combo .input-group-text {
        color: #4e73df;
        background: #f8f9fc;
        border-color: #d1d3e2;
        font-size: .8rem;
    }

    .dashboard-filter-combo .custom-select {
        background-color: #fff;
    }

    .dashboard-card-loading {
        position: relative;
    }

    .dashboard-card-loading::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 5;
        border-radius: var(--dashboard-radius);
        background: rgba(255, 255, 255, .72);
        backdrop-filter: blur(1px);
    }

    .dashboard-card-loading::before {
        content: "Loading...";
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 6;
        transform: translate(-50%, -50%);
        padding-left: 1.6rem;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #4e73df;
    }

    .dashboard-loading-spinner {
        position: absolute;
        top: 50%;
        left: calc(50% - 3.1rem);
        z-index: 7;
        width: 1rem;
        height: 1rem;
        margin-top: -.5rem;
        border: 2px solid rgba(78, 115, 223, .2);
        border-top-color: #4e73df;
        border-radius: 50%;
        animation: dashboardSpin .75s linear infinite;
        pointer-events: none;
    }

    .dashboard-quick-link {
        text-decoration: none;
    }

    .dashboard-quick-link .card {
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .dashboard-quick-link:hover .card {
        transform: translateY(-1px);
        box-shadow: 0 .25rem .75rem rgba(58, 59, 69, .18) !important;
    }

    .dashboard-skeleton {
        display: inline-block;
        min-width: 3rem;
        min-height: 1rem;
        border-radius: .35rem;
        color: transparent;
        background: linear-gradient(90deg, #edf2f7 25%, #f8fafc 37%, #edf2f7 63%);
        background-size: 400% 100%;
        animation: dashboardSkeleton 1.3s ease infinite;
    }

    @@keyframes dashboardSkeleton {
        0% { background-position: 100% 50%; }
        100% { background-position: 0 50%; }
    }

    @@keyframes dashboardSpin {
        to { transform: rotate(360deg); }
    }

    .dashboard-chart-explorer {
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .dashboard-chart-explorer > .card-header,
    .dashboard-chart-explorer > .dashboard-metric-tabs {
        flex: 0 0 auto;
    }

    .dashboard-chart-explorer > .card-body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
        padding-bottom: .75rem;
    }

    .dashboard-metric-tabs {
        display: flex;
        flex-wrap: nowrap;
        gap: 0;
        overflow-x: auto;
        border-bottom: 1px solid #e3e6f0;
        background: #f8f9fc;
        -webkit-overflow-scrolling: touch;
    }

    .dashboard-metric-tab {
        position: relative;
        flex: 1 1 0;
        min-width: 9.5rem;
        margin: 0;
        padding: .85rem 1rem .9rem;
        border: 0;
        border-right: 1px solid #e3e6f0;
        background: transparent;
        text-align: left;
        cursor: pointer;
        color: inherit;
        transition: background .15s ease;
    }

    .dashboard-metric-tab:last-child {
        border-right: 0;
    }

    .dashboard-metric-tab:hover {
        background: #fff;
    }

    .dashboard-metric-tab.is-active {
        background: #fff;
    }

    .dashboard-metric-tab.is-active::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: #4e73df;
    }

    .dashboard-metric-tab .tab-label {
        display: block;
        margin-bottom: .35rem;
        font-size: .65rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #858796;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dashboard-metric-tab.is-active .tab-label {
        color: #4e73df;
    }

    .dashboard-metric-tab .tab-value {
        display: block;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.2;
        color: #5a5c69;
    }

    .dashboard-metric-tab .tab-meta {
        display: block;
        margin-top: .2rem;
        font-size: .72rem;
        color: #858796;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dashboard-chart-panels {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 22rem;
        position: relative;
    }

    .dashboard-chart-panel {
        display: none;
        flex: 1 1 auto;
        min-height: 0;
    }

    .dashboard-chart-panel.is-active {
        display: flex;
        flex-direction: column;
        min-height: 0;
        height: 100%;
    }

    .dashboard-chart-panel .chart-area {
        flex: 1 1 auto;
        position: relative;
        width: 100%;
        min-height: 20rem;
        height: 100%;
    }

    .dashboard-chart-panel .chart-area canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
    }

    .dashboard-insights-panel {
        display: none;
    }

    .dashboard-insights-panel.is-active {
        display: block;
    }

    .dashboard-insights-card > .card-body {
        padding: .85rem 1rem 1.05rem;
    }

    .dashboard-kpi-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .65rem;
    }

    .dashboard-kpi {
        padding: .8rem .85rem;
        border-radius: var(--dashboard-radius);
        background: #f8fafc;
        border: 1px solid #eef2f7;
        min-width: 0;
    }

    .dashboard-kpi.is-requests {
        background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
        border-color: #e2e8f0;
    }

    .dashboard-kpi.is-modules {
        background: linear-gradient(180deg, #f8fafc 0%, #ecfeff 100%);
        border-color: #e2e8f0;
    }

    .dashboard-kpi.is-peak {
        background: linear-gradient(180deg, #f8fafc 0%, #fff7ed 100%);
        border-color: #e2e8f0;
    }

    .dashboard-kpi.is-failed {
        background: linear-gradient(180deg, #f8fafc 0%, #fef2f2 100%);
        border-color: #fee2e2;
    }

    .dashboard-kpi.is-success {
        background: linear-gradient(180deg, #f8fafc 0%, #f0fdf4 100%);
        border-color: #dcfce7;
    }

    .dashboard-kpi-label {
        display: block;
        margin-bottom: .3rem;
        font-size: .65rem;
        font-weight: 650;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #64748b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dashboard-kpi-value {
        display: block;
        font-size: 1.28rem;
        font-weight: 700;
        letter-spacing: -.025em;
        line-height: 1.15;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dashboard-kpi.is-failed .dashboard-kpi-value { color: #b91c1c; }
    .dashboard-kpi.is-success .dashboard-kpi-value { color: #15803d; }
    .dashboard-kpi.is-peak .dashboard-kpi-value { color: #b45309; }
    .dashboard-kpi.is-modules .dashboard-kpi-value { color: #0e7490; }
    .dashboard-kpi.is-requests .dashboard-kpi-value { color: #3730a3; }

    .dashboard-module-totals {
        margin-top: 1rem;
        padding-top: .9rem;
        border-top: 1px solid #f1f5f9;
    }

    .dashboard-module-totals-title {
        margin-bottom: .55rem;
        font-size: .68rem;
        font-weight: 650;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #64748b;
    }

    .dashboard-module-total-row {
        padding: .45rem 0;
    }

    .dashboard-module-total-row + .dashboard-module-total-row {
        border-top: 1px solid #f8fafc;
    }

    .dashboard-module-total-meta {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .3rem;
    }

    .dashboard-module-total-meta .name {
        min-width: 0;
        font-size: .8125rem;
        font-weight: 600;
        color: #1e293b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dashboard-module-total-meta .count {
        flex: 0 0 auto;
        font-size: .8125rem;
        font-weight: 700;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
    }

    .dashboard-module-totals-empty {
        padding: .55rem 0;
        font-size: .8rem;
        color: #94a3b8;
    }
</style>

@section TopbarActions {
    <form method="get" action="@Url.Action("Index", "Home")" class="portal-topbar-filter" data-module-combo>
        <label class="portal-topbar-filter__label" for="selectedModule">Module</label>
        <div class="portal-topbar-filter__control">
            <span class="portal-topbar-filter__icon" aria-hidden="true">
                <i class="fas fa-layer-group"></i>
            </span>
            <span class="portal-topbar-filter__copy">
                <span class="portal-topbar-filter__kicker">Module</span>
                <span class="portal-topbar-filter__value" data-module-combo-value>@(Model.SelectedModule)</span>
            </span>
            <i class="fas fa-chevron-down portal-topbar-filter__caret" aria-hidden="true"></i>
            <select id="selectedModule" name="selectedModule" class="portal-topbar-filter__select" aria-label="Module filter" tabindex="-1">
            @{
                var selectedModuleValue = ModuleOptionValue(Model.SelectedModule);
            }
            @foreach (var module in Model.ModuleOptions)
            {
                var optionValue = ModuleOptionValue(module);
                if (string.Equals(optionValue, selectedModuleValue, StringComparison.OrdinalIgnoreCase))
                {
                    <option selected="selected" value="@optionValue">@module</option>
                }
                else
                {
                    <option value="@optionValue">@module</option>
                }
            }
            </select>
            <button type="button" class="portal-topbar-filter__trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="Choose module"></button>
        </div>
    </form>
}

<div class="container-fluid portal-dashboard">
    <div class="row">
        <div class="col-xl-3 col-md-6 col-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Modules</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><span id="totalModules" class="dashboard-skeleton">0</span></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-layer-group fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Endpoints</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><span id="totalEndpoints" class="dashboard-skeleton">0</span></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-link fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Permission Groups</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><span id="totalPermissionGroups" class="dashboard-skeleton">0</span></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user-shield fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Total Users</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><span id="totalUsers" class="dashboard-skeleton">0</span></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.ManagementQuickLinks.Any())
    {
        <div class="row">
            @foreach (var link in Model.ManagementQuickLinks)
            {
                <div class="col-xl-3 col-md-6 col-6 mb-4">
                    <a class="dashboard-quick-link" href="@link.Url">
                        <div class="card border-left-secondary shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">@link.Title</div>
                                        <div class="small mb-0 font-weight-bold text-gray-800">@link.Description</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-fw @link.IconCss fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

    <div class="row align-items-stretch">
        <div class="col-xl-8 col-lg-7 mb-4">
            <div id="chartExplorerCard" class="card shadow h-100 dashboard-chart-explorer dashboard-card-loading">
                <span class="dashboard-loading-spinner"></span>
                <div class="dashboard-metric-tabs" role="tablist" aria-label="Dashboard charts">
                    <button type="button" class="dashboard-metric-tab is-active" data-chart-tab="hourly" role="tab" aria-selected="true">
                        <span class="tab-label">24h Requests</span>
                        <span class="tab-value"><span id="tabRequests24Hours" class="dashboard-skeleton">0</span></span>
                        <span class="tab-meta">Peak <span id="tabPeakHour24Hours">--:--</span> · <span id="tabPeakRequests24Hours">0</span></span>
                    </button>
                    <button type="button" class="dashboard-metric-tab" data-chart-tab="daily" role="tab" aria-selected="false">
                        <span class="tab-label">7-Day Requests</span>
                        <span class="tab-value"><span id="tabRequestsSevenDays" class="dashboard-skeleton">0</span></span>
                        <span class="tab-meta">Peak <span id="tabPeakDaySevenDays">-</span> · <span id="tabPeakRequestsSevenDays">0</span></span>
                    </button>
                    <button type="button" class="dashboard-metric-tab" data-chart-tab="duration" role="tab" aria-selected="false">
                        <span class="tab-label">Duration</span>
                        <span class="tab-value"><span id="tabAvgDuration" class="dashboard-skeleton">0</span><span class="small font-weight-normal text-muted"> ms</span></span>
                        <span class="tab-meta">Max <span id="tabMaxDuration">0</span> · Min <span id="tabMinDuration">0</span></span>
                    </button>
                    <button type="button" class="dashboard-metric-tab" data-chart-tab="status" role="tab" aria-selected="false">
                        <span class="tab-label">Status Codes</span>
                        <span class="tab-value"><span id="tabSuccessRate" class="dashboard-skeleton">0%</span></span>
                        <span class="tab-meta"><span id="tabFailedRequests">0</span> failed · 7 days</span>
                    </button>
                </div>
                <div class="card-header py-3 border-0">
                    <h6 id="activeChartTitle" class="m-0 font-weight-bold text-primary">Module Requests (Last 24 Hours) - <span class="selected-module-title">@Model.SelectedModule</span></h6>
                    <div id="activeChartSubtitle" class="small text-muted">Times shown in your local timezone</div>
                </div>
                <div class="card-body pt-0">
                    <div class="dashboard-chart-panels">
                        <div class="dashboard-chart-panel is-active" data-chart-panel="hourly">
                            <div class="chart-area"><canvas id="hourlyRequestsChart"></canvas></div>
                        </div>
                        <div class="dashboard-chart-panel" data-chart-panel="daily">
                            <div class="chart-area"><canvas id="dailyRequestsChart"></canvas></div>
                        </div>
                        <div class="dashboard-chart-panel" data-chart-panel="duration">
                            <div class="chart-area"><canvas id="durationTrendChart"></canvas></div>
                        </div>
                        <div class="dashboard-chart-panel" data-chart-panel="status">
                            <div class="chart-area"><canvas id="statusCodeChart"></canvas></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-lg-5 mb-4">
            <div id="operationalInsightsCard" class="card h-100 dashboard-data-card dashboard-insights-card dashboard-card-loading">
                <span class="dashboard-loading-spinner"></span>
                <div class="card-header">
                    <h6 id="insightsCardTitle">Operational Insights</h6>
                    <div id="insightsCardSubtitle" class="card-subtitle">Last 24 hours</div>
                </div>
                <div class="card-body">
                    <div class="dashboard-insights-panel is-active" data-insights-panel="hourly">
                        <div class="dashboard-kpi-grid">
                            <div class="dashboard-kpi is-requests">
                                <span class="dashboard-kpi-label">Requests</span>
                                <span class="dashboard-kpi-value"><span id="requests24Hours" class="dashboard-skeleton">0</span></span>
                            </div>
                            <div class="dashboard-kpi is-modules">
                                <span class="dashboard-kpi-label">Active Modules</span>
                                <span class="dashboard-kpi-value"><span id="activeModules24Hours" class="dashboard-skeleton">0</span></span>
                            </div>
                            <div class="dashboard-kpi is-peak">
                                <span class="dashboard-kpi-label">Peak Hour</span>
                                <span class="dashboard-kpi-value"><span id="peakHour24Hours" class="dashboard-skeleton">--:--</span></span>
                            </div>
                            <div class="dashboard-kpi is-peak">
                                <span class="dashboard-kpi-label">Peak Requests</span>
                                <span class="dashboard-kpi-value"><span id="peakRequests24Hours" class="dashboard-skeleton">0</span></span>
                            </div>
                            <div class="dashboard-kpi is-failed">
                                <span class="dashboard-kpi-label">Failed</span>
                                <span class="dashboard-kpi-value"><span id="failedRequests24Hours" class="dashboard-skeleton">0</span></span>
                            </div>
                            <div class="dashboard-kpi is-success">
                                <span class="dashboard-kpi-label">Success Rate</span>
                                <span class="dashboard-kpi-value"><span id="successRate24Hours" class="dashboard-skeleton">0%</span></span>
                            </div>
                        </div>
                        <div class="dashboard-module-totals">
                            <div class="dashboard-module-totals-title">Module totals</div>
                            <div id="moduleTotals24HoursList">
                                <div class="dashboard-skeleton w-100">&nbsp;</div>
                            </div>
                        </div>
                    </div>
                    <div class="dashboard-insights-panel" data-insights-panel="daily">
                        <div class="dashboard-kpi-grid">
                            <div class="dashboard-kpi is-requests">
                                <span class="dashboard-kpi-label">Requests</span>
                                <span class="dashboard-kpi-value"><span id="requestsSevenDays" class="dashboard-skeleton">0</span></span>
                            </div>
                            <div class="dashboard-kpi is-modules">
                                <span class="dashboard-kpi-label">Active Modules</span>
                                <span class="dashboard-kpi-value"><span id="activeModulesSevenDays" class="dashboard-skeleton">0</span></span>
                            </div>
                            <div class="dashboard-kpi is-peak">
                                <span class="dashboard-kpi-label">Peak Day</span>
                                <span class="dashboard-kpi-value"><span id="peakDaySevenDays" class="dashboard-skeleton">-</span></span>
                            </div>
                            <div class="dashboard-kpi is-peak">
                                <span class="dashboard-kpi-label">Peak Requests</span>
                                <span class="dashboard-kpi-value"><span id="peakRequestsSevenDays" class="dashboard-skeleton">0</span></span>
                            </div>
                            <div class="dashboard-kpi is-failed">
                                <span class="dashboard-kpi-label">Failed</span>
                                <span class="dashboard-kpi-value"><span id="failedRequestsSevenDays" class="dashboard-skeleton">0</span></span>
                            </div>
                            <div class="dashboard-kpi is-success">
                                <span class="dashboard-kpi-label">Success Rate</span>
                                <span class="dashboard-kpi-value"><span id="successRateSevenDays" class="dashboard-skeleton">0%</span></span>
                            </div>
                        </div>
                        <div class="dashboard-module-totals">
                            <div class="dashboard-module-totals-title">Module totals</div>
                            <div id="moduleTotalsList">
                                <div class="dashboard-skeleton w-100">&nbsp;</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div id="dailyDetailsCard" class="card h-100 dashboard-data-card dashboard-card-loading">
                <span class="dashboard-loading-spinner"></span>
                <div class="card-header">
                    <h6>Daily Request Details</h6>
                    <div class="card-subtitle">Latency breakdown for the last 7 days</div>
                </div>
                <div class="card-body">
                    <div class="dashboard-table-scroll dashboard-daily-details-scroll">
                        <table class="dashboard-modern-table">
                            <thead>
                                <tr>
                                    <th>Day</th>
                                    <th class="text-right">Requests</th>
                                    <th class="text-right">Avg</th>
                                    <th class="text-right">Max</th>
                                    <th class="text-right">Min</th>
                                </tr>
                            </thead>
                            <tbody id="dailyRequestDetailsBody">
                                <tr>
                                    <td colspan="5"><span class="dashboard-skeleton w-100">&nbsp;</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div id="topServicesCard" class="card h-100 dashboard-data-card dashboard-card-loading">
                <span class="dashboard-loading-spinner"></span>
                <div class="card-header">
                    <h6>Top Called Services</h6>
                    <div class="card-subtitle">Last 7 days · <span class="selected-module-title">@Model.SelectedModule</span></div>
                </div>
                <div class="card-body">
                    <div class="dashboard-table-scroll">
                        <table class="dashboard-modern-table">
                            <thead>
                                <tr>
                                    <th>Module</th>
                                    <th>Service</th>
                                    <th class="text-right">Requests</th>
                                </tr>
                            </thead>
                            <tbody id="topServicesBody">
                                <tr>
                                    <td colspan="3"><span class="dashboard-skeleton w-100">&nbsp;</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.0.1/dist/chart.umd.min.js"></script>
<script>
    const dashboardSummaryUrl = '@Url.Action("DashboardSummary", "Home")';
    const dashboardHourlyUrl = '@Url.Action("DashboardHourlyMetrics", "Home")';
    const dashboardSevenDayUrl = '@Url.Action("DashboardSevenDayMetrics", "Home")';
    const dashboardStatusUrl = '@Url.Action("DashboardStatusMetrics", "Home")';
    const dashboardTopServicesUrl = '@Url.Action("DashboardTopServices", "Home")';
    const modulePalette = ['#4e73df', '#1cc88a', '#f6c23e', '#e74a3b', '#36b9cc', '#858796', '#5a5c69', '#6610f2', '#fd7e14', '#20c997'];
    let hourlyRequestsChart;
    let dailyRequestsChart;
    let durationTrendChart;
    let statusCodeChart;
    let activeChartTab = 'hourly';
    const chartTabMeta = {
        hourly: {
            title: 'Module Requests (Last 24 Hours)',
            subtitle: 'Times shown in your local timezone',
            insights: 'hourly',
            insightsTitle: 'Operational Insights',
            insightsSubtitle: 'Last 24 hours'
        },
        daily: {
            title: 'Daily HTTP Request Stats (Last 7 Days)',
            subtitle: '',
            insights: 'daily',
            insightsTitle: 'Operational Insights',
            insightsSubtitle: 'Last 7 days'
        },
        duration: {
            title: 'Duration Trends (Avg / Max / Min) - Milliseconds',
            subtitle: '',
            insights: 'daily',
            insightsTitle: 'Operational Insights',
            insightsSubtitle: 'Last 7 days'
        },
        status: {
            title: 'HTTP Status Code Distribution',
            subtitle: '',
            insights: 'daily',
            insightsTitle: 'Operational Insights',
            insightsSubtitle: 'Last 7 days'
        }
    };
    const dashboardState = {
        selectedModule: '@Model.SelectedModule',
        hourKeys: [],
        hourLabels: [],
        moduleHourlySeries: [],
        totalHourlyTotals: [],
        statusStats24Hours: [],
        dailyStats: [],
        totalDailyStats: [],
        moduleDailySeries: [],
        moduleTotals: [],
        statusStats: [],
        topServices: []
    };

    const readProp = (item, name) => item?.[name] ?? item?.[name.charAt(0).toLowerCase() + name.slice(1)];
    const readArray = (item, name) => readProp(item, name) || [];
    const readNumber = (item, name) => Number(readProp(item, name) || 0);
    const trimModuleSuffix = value => (value || '').replace(/\s+module$/i, '');
    const encodeModule = () => encodeURIComponent(document.getElementById('selectedModule')?.value || 'All Modules');
    const metricCardIds = ['chartExplorerCard', 'operationalInsightsCard', 'dailyDetailsCard', 'topServicesCard'];
    const chartByTab = () => ({
        hourly: hourlyRequestsChart,
        daily: dailyRequestsChart,
        duration: durationTrendChart,
        status: statusCodeChart
    });
    const setActiveChartTab = (tab) => {
        if (!chartTabMeta[tab]) return;
        activeChartTab = tab;
        document.querySelectorAll('.dashboard-metric-tab').forEach(button => {
            const isActive = button.getAttribute('data-chart-tab') === tab;
            button.classList.toggle('is-active', isActive);
            button.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        document.querySelectorAll('.dashboard-chart-panel').forEach(panel => {
            panel.classList.toggle('is-active', panel.getAttribute('data-chart-panel') === tab);
        });
        const meta = chartTabMeta[tab];
        document.querySelectorAll('.dashboard-insights-panel').forEach(panel => {
            panel.classList.toggle('is-active', panel.getAttribute('data-insights-panel') === meta.insights);
        });
        const titleEl = document.getElementById('activeChartTitle');
        const subtitleEl = document.getElementById('activeChartSubtitle');
        const insightsTitleEl = document.getElementById('insightsCardTitle');
        const insightsSubtitleEl = document.getElementById('insightsCardSubtitle');
        if (titleEl) {
            titleEl.innerHTML = `${meta.title} - <span class="selected-module-title">${dashboardState.selectedModule}</span>`;
        }
        if (subtitleEl) {
            subtitleEl.textContent = meta.subtitle || '';
            subtitleEl.style.display = meta.subtitle ? '' : 'none';
        }
        if (insightsTitleEl) insightsTitleEl.textContent = meta.insightsTitle;
        if (insightsSubtitleEl) insightsSubtitleEl.textContent = meta.insightsSubtitle || '';
        requestAnimationFrame(() => {
            const chart = chartByTab()[tab];
            if (chart) chart.resize();
        });
    };
    const setCardLoading = (id, isLoading) => {
        const card = document.getElementById(id);
        if (!card) return;
        card.classList.toggle('dashboard-card-loading', isLoading);
        const spinner = card.querySelector('.dashboard-loading-spinner');
        if (spinner) spinner.style.display = isLoading ? '' : 'none';
    };
    const setMetricCardsLoading = (isLoading) => metricCardIds.forEach(id => setCardLoading(id, isLoading));
    const setText = (id, value) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('dashboard-skeleton');
        el.textContent = value;
    };
    const setLoadingText = (id) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.add('dashboard-skeleton');
        el.textContent = '0';
    };
    const getStatusText = (code) => {
        if (code >= 200 && code <= 299) return 'Success';
        if (code >= 300 && code <= 399) return 'Redirect';
        if (code === 404) return 'Not Found';
        if (code >= 400 && code <= 499) return 'Client Error';
        if (code >= 500 && code <= 599) return 'Server Error';
        return 'Unknown';
    };
    const isDashboardFailureStatus = code => code >= 400 && code !== 404;
    const getEmptyLast24HourLabels = () => Array.from({ length: 24 }, () => '');
    const parseUtcHourKey = hourKey => {
        if (!hourKey) return null;
        const normalized = hourKey.includes('T')
            ? (hourKey.endsWith('Z') ? hourKey : `${hourKey}Z`)
            : `${hourKey.replace(' ', 'T')}Z`;
        const date = new Date(normalized);
        return Number.isNaN(date.getTime()) ? null : date;
    };
    const formatLocalHourLabel = hourKey => {
        const date = parseUtcHourKey(hourKey);
        if (!date) return hourKey || '';
        return date.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', hour12: false });
    };
    const formatLocalHourLabels = hourKeys => (hourKeys || []).map(formatLocalHourLabel);
    const resolveHourLabels = (hourKeys, fallbackLabels) => {
        if (Array.isArray(hourKeys) && hourKeys.length === 24) {
            return formatLocalHourLabels(hourKeys);
        }
        return Array.isArray(fallbackLabels) && fallbackLabels.length === 24
            ? fallbackLabels
            : getEmptyLast24HourLabels();
    };

    const createCharts = () => {
        const hourlyCtx = document.getElementById('hourlyRequestsChart');
        if (hourlyCtx) {
            hourlyRequestsChart = new Chart(hourlyCtx, {
                type: 'line',
                data: { labels: getEmptyLast24HourLabels(), datasets: [] },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { title: { display: true, text: 'Hour (local time)' } },
                        y: { beginAtZero: true, title: { display: true, text: 'Requests' } }
                    },
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        const ctx = document.getElementById('dailyRequestsChart');
        if (ctx) {
            dailyRequestsChart = new Chart(ctx, {
                type: 'bar',
                data: { labels: [], datasets: [{ label: 'Total Requests', data: [], backgroundColor: 'rgba(78, 115, 223, 0.65)', borderColor: 'rgba(78, 115, 223, 1)', borderWidth: 1, yAxisID: 'y' }] },
                options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, title: { display: true, text: 'Requests' } } } }
            });
        }

        const durationCtx = document.getElementById('durationTrendChart');
        if (durationCtx) {
            durationTrendChart = new Chart(durationCtx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [
                        { label: 'Avg (ms)', data: [], borderColor: 'rgba(54, 185, 204, 1)', backgroundColor: 'rgba(54, 185, 204, 0.15)', tension: 0, cubicInterpolationMode: 'monotone' },
                        { label: 'Max (ms)', data: [], borderColor: 'rgba(246, 194, 62, 1)', backgroundColor: 'rgba(246, 194, 62, 0.15)', tension: 0, cubicInterpolationMode: 'monotone' },
                        { label: 'Min (ms)', data: [], borderColor: 'rgba(28, 200, 138, 1)', backgroundColor: 'rgba(28, 200, 138, 0.15)', tension: 0, cubicInterpolationMode: 'monotone' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true, min: 0, title: { display: true, text: 'Milliseconds' } } },
                    plugins: { tooltip: { callbacks: { label: context => `${context.dataset.label}: ${Number(context.raw || 0).toFixed(2)} ms` } } }
                }
            });
        }

        const statusCtx = document.getElementById('statusCodeChart');
        if (statusCtx) {
            statusCodeChart = new Chart(statusCtx, {
                type: 'doughnut',
                data: { labels: [], datasets: [{ data: [], backgroundColor: ['#4e73df', '#1cc88a', '#f6c23e', '#e74a3b', '#36b9cc', '#858796'] }] },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        tooltip: { callbacks: { label: context => `${context.label}: ${Number(context.raw || 0)} requests` } },
                        legend: { position: 'bottom' }
                    }
                }
            });
        }
    };

    const setMetricLoading = () => {
        setMetricCardsLoading(true);
        ['requests24Hours', 'activeModules24Hours', 'peakHour24Hours', 'peakRequests24Hours', 'requestsSevenDays', 'tabRequests24Hours', 'tabRequestsSevenDays', 'tabAvgDuration', 'tabSuccessRate'].forEach(setLoadingText);
        document.getElementById('moduleTotalsList').innerHTML = '<div class="dashboard-skeleton w-100">&nbsp;</div>';
        document.getElementById('moduleTotals24HoursList').innerHTML = '<div class="dashboard-skeleton w-100">&nbsp;</div>';
        document.getElementById('dailyRequestDetailsBody').innerHTML = '<tr><td colspan="5"><span class="dashboard-skeleton w-100">&nbsp;</span></td></tr>';
        document.getElementById('topServicesBody').innerHTML = '<tr><td colspan="3"><span class="dashboard-skeleton w-100">&nbsp;</span></td></tr>';
    };

    const updateSummary = async () => {
        const response = await fetch(`${dashboardSummaryUrl}?selectedModule=${encodeModule()}`);
        if (!response.ok) throw new Error('Dashboard summary request failed.');
        const data = await response.json();
        setText('totalModules', readProp(data, 'TotalModules') ?? 0);
        setText('totalEndpoints', readProp(data, 'TotalEndpoints') ?? 0);
        setText('totalPermissionGroups', readProp(data, 'TotalPermissionGroups') ?? 0);
        setText('totalUsers', readProp(data, 'TotalUsers') ?? 0);
    };

    const updateDailyRequestsChart = (labels, counts, moduleDailySeries, totalDailyStats) => {
        if (!dailyRequestsChart) return;
        const nonEmptyModuleSeries = (moduleDailySeries || [])
            .filter(series => readArray(series, 'DailyTotals').some(value => Number(value || 0) > 0));
        const moduleDatasets = nonEmptyModuleSeries.map((series, index) => {
            const totals = readArray(series, 'DailyTotals');
            const module = readProp(series, 'Module') || '';
            return {
                label: `${module} (${totals.reduce((sum, value) => sum + Number(value || 0), 0)})`,
                data: totals,
                borderColor: modulePalette[index % modulePalette.length],
                backgroundColor: 'transparent',
                borderWidth: 2,
                tension: 0.2,
                type: 'line',
                yAxisID: 'y'
            };
        });
        dailyRequestsChart.data.labels = labels;
        const totalCounts = Array.isArray(totalDailyStats) && totalDailyStats.length
            ? totalDailyStats.map(i => readNumber(i, 'TotalRequests'))
            : counts;
        const totalDataset = {
            label: `Total Requests (${totalCounts.reduce((sum, value) => sum + Number(value || 0), 0)})`,
            data: totalCounts,
            backgroundColor: 'rgba(78, 115, 223, 0.18)',
            borderColor: 'rgba(78, 115, 223, 1)',
            borderWidth: 2,
            type: moduleDatasets.length ? 'line' : 'bar',
            tension: 0.15,
            yAxisID: 'y'
        };
        dailyRequestsChart.data.datasets = [totalDataset, ...moduleDatasets];
        dailyRequestsChart.update();
    };

    const updateHourlyRequestsChart = (hourLabels, moduleHourlySeries, totalHourlyTotals) => {
        if (!hourlyRequestsChart) return;
        hourlyRequestsChart.data.labels = Array.isArray(hourLabels) && hourLabels.length === 24
            ? hourLabels
            : getEmptyLast24HourLabels();
        const nonEmptyModuleSeries = (moduleHourlySeries || [])
            .filter(series => readArray(series, 'HourlyTotals').some(value => Number(value || 0) > 0));
        const moduleDatasets = nonEmptyModuleSeries.map((series, index) => {
            const totals = readArray(series, 'HourlyTotals');
            const module = readProp(series, 'Module') || '';
            return {
                label: `${module} (${totals.reduce((sum, value) => sum + Number(value || 0), 0)})`,
                data: totals,
                borderColor: modulePalette[index % modulePalette.length],
                backgroundColor: 'transparent',
                borderWidth: 2,
                tension: 0.25
            };
        });
        const globalHourlyTotals = Array.isArray(totalHourlyTotals) && totalHourlyTotals.length
            ? totalHourlyTotals
            : hourlyRequestsChart.data.labels.map((_, index) =>
                (moduleHourlySeries || []).reduce((sum, series) => sum + Number(readArray(series, 'HourlyTotals')[index] || 0), 0));
        const totalDataset = {
            label: `Total Requests (${globalHourlyTotals.reduce((sum, value) => sum + Number(value || 0), 0)})`,
            data: globalHourlyTotals,
            borderColor: 'rgba(78, 115, 223, 1)',
            backgroundColor: 'rgba(78, 115, 223, 0.14)',
            borderWidth: 2,
            tension: 0.2
        };
        hourlyRequestsChart.data.datasets = [totalDataset, ...moduleDatasets];
        hourlyRequestsChart.update();
    };

    const updateDurationChart = (labels, dailyStats) => {
        if (!durationTrendChart) return;
        durationTrendChart.data.labels = labels;
        durationTrendChart.data.datasets[0].data = dailyStats.map(i => Math.max(0, Number(readProp(i, 'AvgDurationMs') || 0)));
        durationTrendChart.data.datasets[1].data = dailyStats.map(i => Math.max(0, Number(readProp(i, 'MaxDurationMs') || 0)));
        durationTrendChart.data.datasets[2].data = dailyStats.map(i => Math.max(0, Number(readProp(i, 'MinDurationMs') || 0)));
        durationTrendChart.update();
    };

    const updateStatusChart = (statusItems) => {
        if (!statusCodeChart) return;
        const statusTotal = statusItems.reduce((sum, item) => sum + readNumber(item, 'TotalRequests'), 0);
        const getStatusPercent = count => statusTotal > 0 ? ((Number(count || 0) * 100) / statusTotal).toFixed(1) : '0.0';
        statusCodeChart.data.labels = statusItems.map(item => {
            const code = readNumber(item, 'StatusCode');
            const count = readNumber(item, 'TotalRequests');
            return `${code} ${getStatusText(code)} - ${count} (${getStatusPercent(count)}%)`;
        });
        statusCodeChart.data.datasets[0].data = statusItems.map(item => readNumber(item, 'TotalRequests'));
        statusCodeChart.update();
    };

    const formatCount = value => Number(value || 0).toLocaleString();

    const renderModuleTotalsList = (targetId, items, emptyText) => {
        const target = document.getElementById(targetId);
        if (!target) return;
        target.innerHTML = '';
        if (!items.length) {
            target.innerHTML = `<div class="dashboard-module-totals-empty">${emptyText}</div>`;
            return;
        }
        const maxRequests = Math.max(...items.map(item => readNumber(item, 'TotalRequests')), 1);
        items.slice(0, 6).forEach(item => {
            const total = readNumber(item, 'TotalRequests');
            const width = Math.max(6, Math.round((total / maxRequests) * 100));
            const row = document.createElement('div');
            row.className = 'dashboard-module-total-row';
            row.innerHTML = `
                <div class="dashboard-module-total-meta">
                    <span class="name">${readProp(item, 'Module') || ''}</span>
                    <strong class="count">${formatCount(total)}</strong>
                </div>
                <span class="dashboard-req-bar" aria-hidden="true"><span style="width:${width}%"></span></span>`;
            target.appendChild(row);
        });
    };

    const renderOperationalInsights = () => {
        const dailyStats = dashboardState.dailyStats;
        const statusStats = dashboardState.statusStats;
        const statusStats24Hours = dashboardState.statusStats24Hours;
        const moduleTotals = dashboardState.moduleTotals;
        const moduleHourlySeries = dashboardState.moduleHourlySeries;
        const hourLabels = dashboardState.hourLabels;

        const hourlyTotals = Array.isArray(dashboardState.totalHourlyTotals) && dashboardState.totalHourlyTotals.length
            ? dashboardState.totalHourlyTotals
            : Array.from({ length: 24 }, (_, index) =>
                moduleHourlySeries.reduce((sum, series) => sum + Number((readArray(series, 'HourlyTotals')[index]) || 0), 0));
        const total24Hours = hourlyTotals.reduce((sum, value) => sum + value, 0);
        const peakRequests = hourlyTotals.length ? Math.max(...hourlyTotals) : 0;
        const peakIndex = hourlyTotals.indexOf(peakRequests);
        const activeModules = moduleHourlySeries.filter(series =>
            readArray(series, 'HourlyTotals').reduce((sum, value) => sum + Number(value || 0), 0) > 0).length;
        const failedRequests24Hours = statusStats24Hours
            .filter(item => isDashboardFailureStatus(readNumber(item, 'StatusCode')))
            .reduce((sum, item) => sum + readNumber(item, 'TotalRequests'), 0);
        const totalStatusRequests24Hours = statusStats24Hours
            .reduce((sum, item) => sum + readNumber(item, 'TotalRequests'), 0);
        const successRate24Hours = totalStatusRequests24Hours > 0
            ? (((totalStatusRequests24Hours - failedRequests24Hours) * 100) / totalStatusRequests24Hours).toFixed(1)
            : '0.0';

        const totalDailyStats = Array.isArray(dashboardState.totalDailyStats) && dashboardState.totalDailyStats.length
            ? dashboardState.totalDailyStats
            : dailyStats;
        const totalLastSevenDays = totalDailyStats.reduce((sum, item) => sum + readNumber(item, 'TotalRequests'), 0);
        const activeModulesSevenDays = moduleTotals.filter(item => readNumber(item, 'TotalRequests') > 0).length;
        const peakDayItem = totalDailyStats.reduce((peak, item) =>
            readNumber(item, 'TotalRequests') > readNumber(peak, 'TotalRequests') ? item : peak, {});
        const peakDayRequests = readNumber(peakDayItem, 'TotalRequests');
        const failedRequestsSevenDays = statusStats
            .filter(item => isDashboardFailureStatus(readNumber(item, 'StatusCode')))
            .reduce((sum, item) => sum + readNumber(item, 'TotalRequests'), 0);
        const totalStatusRequestsSevenDays = statusStats
            .reduce((sum, item) => sum + readNumber(item, 'TotalRequests'), 0);
        const successRateSevenDays = totalStatusRequestsSevenDays > 0
            ? (((totalStatusRequestsSevenDays - failedRequestsSevenDays) * 100) / totalStatusRequestsSevenDays).toFixed(1)
            : '0.0';

        const avgDuration = dailyStats.length
            ? (dailyStats.reduce((sum, item) => sum + Number(readProp(item, 'AvgDurationMs') || 0), 0) / dailyStats.length)
            : 0;
        const maxDuration = dailyStats.length
            ? Math.max(...dailyStats.map(item => Number(readProp(item, 'MaxDurationMs') || 0)))
            : 0;
        const minDuration = dailyStats.length
            ? Math.min(...dailyStats.map(item => Number(readProp(item, 'MinDurationMs') || 0)))
            : 0;
        const peakHourLabel = peakRequests > 0 ? (hourLabels[peakIndex] || '--:--') : '--:--';
        const peakDayLabel = peakDayRequests > 0 ? (readProp(peakDayItem, 'RequestDay') || '-') : '-';

        setText('requests24Hours', formatCount(total24Hours));
        setText('activeModules24Hours', activeModules);
        setText('peakHour24Hours', peakHourLabel);
        setText('peakRequests24Hours', formatCount(peakRequests));
        setText('failedRequests24Hours', formatCount(failedRequests24Hours));
        setText('successRate24Hours', `${successRate24Hours}%`);
        setText('requestsSevenDays', formatCount(totalLastSevenDays));
        setText('activeModulesSevenDays', activeModulesSevenDays);
        setText('peakDaySevenDays', peakDayLabel);
        setText('peakRequestsSevenDays', formatCount(peakDayRequests));
        setText('failedRequestsSevenDays', formatCount(failedRequestsSevenDays));
        setText('successRateSevenDays', `${successRateSevenDays}%`);

        setText('tabRequests24Hours', formatCount(total24Hours));
        setText('tabPeakHour24Hours', peakHourLabel);
        setText('tabPeakRequests24Hours', formatCount(peakRequests));
        setText('tabRequestsSevenDays', formatCount(totalLastSevenDays));
        setText('tabPeakDaySevenDays', peakDayLabel);
        setText('tabPeakRequestsSevenDays', formatCount(peakDayRequests));
        setText('tabAvgDuration', avgDuration.toFixed(1));
        setText('tabMaxDuration', formatCount(maxDuration));
        setText('tabMinDuration', formatCount(minDuration));
        setText('tabSuccessRate', `${successRateSevenDays}%`);
        setText('tabFailedRequests', formatCount(failedRequestsSevenDays));

        const moduleTotals24Hours = moduleHourlySeries
            .map(series => ({
                Module: readProp(series, 'Module') || '',
                TotalRequests: readArray(series, 'HourlyTotals').reduce((sum, value) => sum + Number(value || 0), 0)
            }))
            .filter(item => item.Module)
            .sort((left, right) => Number(right.TotalRequests || 0) - Number(left.TotalRequests || 0));

        renderModuleTotalsList('moduleTotals24HoursList', moduleTotals24Hours, 'No module totals in the last 24 hours yet.');
        renderModuleTotalsList('moduleTotalsList', moduleTotals, 'No module totals yet.');
    };

    const methodClass = method => {
        const key = String(method || '').trim().toUpperCase();
        if (key === 'GET') return 'is-get';
        if (key === 'POST') return 'is-post';
        if (key === 'PUT') return 'is-put';
        if (key === 'PATCH') return 'is-patch';
        if (key === 'DELETE') return 'is-delete';
        return 'is-other';
    };

    const renderTables = (dailyStats, topServices) => {
        const dailyBody = document.getElementById('dailyRequestDetailsBody');
        if (!dailyStats.length) {
            dailyBody.innerHTML = '<tr><td colspan="5"><div class="dashboard-table-empty">No request statistics yet.</div></td></tr>';
        } else {
            const dailyRows = [...dailyStats].sort((left, right) =>
                String(readProp(right, 'RequestDay') || '').localeCompare(String(readProp(left, 'RequestDay') || '')));
            dailyBody.innerHTML = '';
            dailyRows.forEach(stat => {
                dailyBody.insertAdjacentHTML('beforeend', `
                    <tr>
                        <td class="col-day">${readProp(stat, 'RequestDay') || ''}</td>
                        <td class="col-num">${formatCount(readNumber(stat, 'TotalRequests'))}</td>
                        <td class="col-muted text-right">${Number(readProp(stat, 'AvgDurationMs') || 0).toFixed(1)} ms</td>
                        <td class="col-muted text-right">${formatCount(readNumber(stat, 'MaxDurationMs'))} ms</td>
                        <td class="col-muted text-right">${formatCount(readNumber(stat, 'MinDurationMs'))} ms</td>
                    </tr>`);
            });
        }

        const topBody = document.getElementById('topServicesBody');
        if (!topServices.length) {
            topBody.innerHTML = '<tr><td colspan="3"><div class="dashboard-table-empty">No service stats yet.</div></td></tr>';
            return;
        }

        const maxRequests = Math.max(...topServices.map(service => readNumber(service, 'TotalRequests')), 1);
        topBody.innerHTML = '';
        topServices.forEach(service => {
            const total = readNumber(service, 'TotalRequests');
            const width = Math.max(6, Math.round((total / maxRequests) * 100));
            const method = readProp(service, 'Method') || '';
            topBody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td class="col-module">${trimModuleSuffix(readProp(service, 'Module'))}</td>
                    <td>
                        <span class="dashboard-method ${methodClass(method)}">${method || '—'}</span>
                        <span class="dashboard-service-path">${readProp(service, 'Path') || ''}</span>
                    </td>
                    <td class="col-num dashboard-req-cell">
                        ${formatCount(total)}
                        <span class="dashboard-req-bar" aria-hidden="true"><span style="width:${width}%"></span></span>
                    </td>
                </tr>`);
        });
    };

    const updateHourlyMetrics = async () => {
        const response = await fetch(`${dashboardHourlyUrl}?selectedModule=${encodeModule()}`);
        if (!response.ok) throw new Error('Dashboard hourly metrics request failed.');
        const data = await response.json();
        dashboardState.selectedModule = readProp(data, 'SelectedModule') || 'All Modules';
        dashboardState.hourKeys = readArray(data, 'Last24HourKeys');
        dashboardState.hourLabels = resolveHourLabels(dashboardState.hourKeys, readArray(data, 'Last24HourLabels'));
        dashboardState.moduleHourlySeries = readArray(data, 'ModuleHourlySeries');
        dashboardState.totalHourlyTotals = readArray(data, 'TotalHourlyTotals');
        dashboardState.statusStats24Hours = readArray(data, 'StatusCodeStats');
        document.querySelectorAll('.selected-module-title').forEach(el => el.textContent = dashboardState.selectedModule);
        updateHourlyRequestsChart(dashboardState.hourLabels, dashboardState.moduleHourlySeries, dashboardState.totalHourlyTotals);
        renderOperationalInsights();
        setActiveChartTab(activeChartTab);
    };

    const updateSevenDayMetrics = async () => {
        const response = await fetch(`${dashboardSevenDayUrl}?selectedModule=${encodeModule()}`);
        if (!response.ok) throw new Error('Dashboard seven day metrics request failed.');
        const data = await response.json();
        dashboardState.selectedModule = readProp(data, 'SelectedModule') || dashboardState.selectedModule;
        dashboardState.dailyStats = readArray(data, 'DailyRequestStats');
        dashboardState.totalDailyStats = readArray(data, 'TotalDailyRequestStats');
        dashboardState.moduleDailySeries = readArray(data, 'ModuleDailySeries');
        dashboardState.moduleTotals = readArray(data, 'ModuleTotalRequests');
        const labelSource = dashboardState.totalDailyStats.length ? dashboardState.totalDailyStats : dashboardState.dailyStats;
        const labels = labelSource.map(i => readProp(i, 'RequestDay') || '');
        const counts = dashboardState.dailyStats.map(i => readNumber(i, 'TotalRequests'));
        document.querySelectorAll('.selected-module-title').forEach(el => el.textContent = dashboardState.selectedModule);
        updateDailyRequestsChart(labels, counts, dashboardState.moduleDailySeries, dashboardState.totalDailyStats);
        updateDurationChart(labels, dashboardState.dailyStats);
        dashboardState.statusStats = readArray(data, 'StatusCodeStats');
        dashboardState.topServices = readArray(data, 'ModuleTopServices');
        updateStatusChart(dashboardState.statusStats);
        renderTables(dashboardState.dailyStats, dashboardState.topServices);
        renderOperationalInsights();
        setActiveChartTab(activeChartTab);
    };

    const updateStatusMetrics = async () => {
        setCardLoading('chartExplorerCard', true);
        try {
            const response = await fetch(`${dashboardStatusUrl}?selectedModule=${encodeModule()}`);
            if (!response.ok) throw new Error('Dashboard status metrics request failed.');
            const data = await response.json();
            dashboardState.statusStats = readArray(data, 'StatusCodeStats');
            updateStatusChart(dashboardState.statusStats);
            renderOperationalInsights();
        } finally {
            setCardLoading('chartExplorerCard', false);
        }
    };

    const updateTopServices = async () => {
        setCardLoading('topServicesCard', true);
        try {
            const response = await fetch(`${dashboardTopServicesUrl}?selectedModule=${encodeModule()}`);
            if (!response.ok) throw new Error('Dashboard top services request failed.');
            const data = await response.json();
            dashboardState.topServices = readArray(data, 'ModuleTopServices');
            renderTables(dashboardState.dailyStats, dashboardState.topServices);
        } finally {
            setCardLoading('topServicesCard', false);
        }
    };

    const updateMetrics = async () => {
        setMetricLoading();
        try {
            await Promise.allSettled([
                updateHourlyMetrics(),
                updateSevenDayMetrics()
            ]);
        } finally {
            setMetricCardsLoading(false);
        }
    };

    const reloadDashboard = async () => {
        await Promise.allSettled([updateSummary(), updateMetrics()]);
    };

    document.addEventListener('DOMContentLoaded', () => {
        createCharts();
        setActiveChartTab(activeChartTab);
        document.querySelectorAll('.dashboard-metric-tab').forEach(button => {
            button.addEventListener('click', () => setActiveChartTab(button.getAttribute('data-chart-tab')));
        });
        reloadDashboard();
        const moduleSelect = document.getElementById('selectedModule');
        if (moduleSelect) {
            moduleSelect.addEventListener('change', () => {
                const url = new URL(window.location.href);
                url.searchParams.set('selectedModule', moduleSelect.value || 'All Modules');
                window.history.replaceState({}, '', url);
                reloadDashboard();
            });
        }
    });
</script>