{
  "QuickcodeClients": {
    "GatewayApi": "http://quickcode-quickcode-gateway-api/",
    "QuickCodeModuleApi": "http://quickcode-quickcode-quick-code-module-api/",
    "IdentityModuleApi": "http://quickcode-quickcode-identity-module-api/"
  },
  "GatewayServiceTokenSettings": {
    "Issuer": "quickcode-gateway",
    "ExpirationSeconds": 60
  },
  "Kafka": {
	"BootstrapServers": "kafka.quickcode.net:9092",
	"GroupId": "WorkflowGroup"
  },
  "JwtSettings": {},
  "AppSettings": {
    "UseHealthCheck": "true",
    "DatabaseType": "mssql",
    "InMemoryDbName": "EventListenerDb",
    "HealthCheckSeconds": "3600"
  },
  "Logging": {
    "ApiName": "quickcode-quick-code-event-listener-service",
    "ElasticConfiguration": {
        "Uri": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Information",
        "Microsoft": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}