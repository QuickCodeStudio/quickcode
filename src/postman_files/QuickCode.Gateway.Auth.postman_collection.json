{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "QuickCode Gateway Auth",
		"description": "Username/password (Bearer) and X-Api-Key flows against the Gateway.\n\n1. Set environment `base_url` (default http://localhost:6060).\n2. Run **Login** once for Bearer requests.\n3. Set `api_key` from the deployment email (or a key you create in the portal). The default key is not stored in this collection.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:6060"
		},
		{
			"key": "access_token",
			"value": ""
		},
		{
			"key": "api_key",
			"value": ""
		},
		{
			"key": "sample_get_path",
			"value": "/api/permission-groups"
		},
		{
			"key": "login_email",
			"value": "demo@quickcode.net"
		},
		{
			"key": "login_password",
			"value": "String1!"
		}
	},
	"item": [
		{
			"name": "1. Username & Password (Bearer)",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var json = pm.response.json();",
									"var token = json.accessToken || json.access_token;",
									"if (token) {",
									"    pm.collectionVariables.set('access_token', token);",
									"    pm.environment.set('access_token', token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Demo user: demo@quickcode.net / String1!\nSaves accessToken to collection + environment as access_token."
					},
					"response": []
				},
				{
					"name": "Sample GET with Bearer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 2xx', function () {",
									"    pm.expect(pm.response.code).to.be.within(200, 299);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}{{sample_get_path}}",
							"host": ["{{base_url}}"],
							"path": ["{{sample_get_path}}"]
						},
						"description": "Uses Bearer token from Login. Change collection variable sample_get_path if your module route differs."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. API Key (X-Api-Key)",
			"item": [
				{
					"name": "Sample GET with X-Api-Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 2xx', function () {",
									"    pm.expect(pm.response.code).to.be.within(200, 299);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [
							{
								"key": "X-Api-Key",
								"value": "{{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}{{sample_get_path}}",
							"host": ["{{base_url}}"],
							"path": ["{{sample_get_path}}"]
						},
						"description": "Same sample path as Bearer, authenticated with X-Api-Key.\nPaste the default Admin API key from the deployment email (or a portal-created key) into `api_key`.\nNo Authorization header needed."
					},
					"response": []
				},
				{
					"name": "List API keys (Admin Bearer)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"if (!pm.collectionVariables.get('access_token') && !pm.environment.get('access_token')) {",
									"    console.warn('Run Login first to set access_token.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/api-keys",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "api-keys"]
						},
						"description": "Admin-only. Requires Login first. Lists keys (prefix + metadata, no plaintext)."
					},
					"response": []
				},
				{
					"name": "Create API key (Admin Bearer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Create status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var json = pm.response.json();",
									"if (json.apiKey) {",
									"    pm.collectionVariables.set('api_key', json.apiKey);",
									"    pm.environment.set('api_key', json.apiKey);",
									"    if (json.id) {",
									"        pm.collectionVariables.set('created_api_key_id', json.id);",
									"        pm.environment.set('created_api_key_id', json.id);",
									"    }",
									"    console.log('New API key saved to api_key (copy now; not shown again).');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Postman created key\",\n  \"description\": \"Created from Postman collection\",\n  \"permissionGroupName\": \"Admin\",\n  \"expiresAt\": \"2099-12-31T23:59:59Z\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/api-keys",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "api-keys"]
						},
						"description": "Admin-only. Returns plaintext apiKey once and stores it in api_key variable."
					},
					"response": []
				},
				{
					"name": "Revoke API key (Admin Bearer)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/api-keys/{{created_api_key_id}}/revoke",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "api-keys", "{{created_api_key_id}}", "revoke"]
						},
						"description": "Admin-only. Uses created_api_key_id from Create. Gateway invalidates in-memory cache on success."
					},
					"response": []
				}
			]
		}
	]
}
