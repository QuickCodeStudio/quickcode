{
  "ConnectionStrings": {
    "ReadConnectionString": "",
    "WriteConnectionString": ""
  },
  "QuickcodeClients": {
    "IdentityModuleApi": "http://quickcode-identity-module-api/"
  },
  "EmailService": {
    "BaseUrl": "https://api.quickcode.net/",
    "SendPath": "api/Email/send-from-template",
    "ProjectKey": "quickcode",
    "PortalUrl": "https://quickcode-portal.quickcode.net",
    "ApiKey": ""
  },
  "QuickcodeApiKeys": {
    "EmailSenderModuleApiKey": ""
  },
  "GatewayServiceTokenSettings": {
    "Issuer": "quickcode-gateway",
    "ExpirationSeconds": 60
  },
  "Kafka": {
	"BootstrapServers": "kafka.quickcode.net:9092",
	"GroupId": "WorkflowGroup"
  },
  "JwtSettings": {},
  "CorsSettings": {
    "AllowOrigins": [ "https://*.quickcode.net", "https://*.europe-west1.run.app" ]
  },
  "AppSettings": {
    "ModuleName": "QuickcodeModule",
        "UseHealthCheck": "true",
    "DatabaseType": "mssql",
    "InMemoryDbName": "QuickcodeModuleDb",
    "HealthCheckSeconds": "3600"
  },
  "Logging": {
    "ApiName": "quickcodemodule-api",
    "ElasticConfiguration": {
        "Uri": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Information",
        "Microsoft": "Information"
      }
    }
  },
  "Auditing": {
    "CaptureFullEntityOnUpdate": true,
    "CaptureFullEntityOnInsert": true,
    "CaptureFullEntityOnDelete": true
  },
  "AllowedHosts": "*"
}