{
  "Swagger": {
    "Title": "QuickCode - Quickcode - IdentityModule Api",
    "TermsOfService": "https://www.quickcode.net",
    "Contact": "https://www.quickcode.net",
    "License": "https://www.quickcode.net"
  },
  "Auditing": {
    "CaptureFullEntityOnUpdate": true,   
    "CaptureFullEntityOnInsert": true,   
    "CaptureFullEntityOnDelete": true
  },
  "CorsSettings": {
    "AllowOrigins": [ "http://localhost:3000", "http://localhost:6060", "http://quickcode-gateway-api", "https://*.quickcode.net", "https://*.europe-west1.run.app" ]
  },
  "EmailService": {
    "BaseUrl": "https://api.quickcode.net/",
    "SendPath": "api/Email/send-from-template",
    "ProjectKey": "quickcode",
    "PortalUrl": "http://localhost:6020",
    "ApiKey": ""
  },
  "QuickcodeApiKeys": {
    "EmailSenderModuleApiKey": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "ApplyAuthPolicies": true,
    "General": {
      "PermitLimit": 1000,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
