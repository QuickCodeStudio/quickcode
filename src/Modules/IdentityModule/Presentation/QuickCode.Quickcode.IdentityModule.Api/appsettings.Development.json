{
  "ConnectionStrings": {
    "ReadConnectionString": "Data Source=quickcode-sql-data;Initial Catalog=quickcode__identity;User ID=SA;Password=Pass@word;TrustServerCertificate=True;",
    "WriteConnectionString": "Data Source=quickcode-sql-data;Initial Catalog=quickcode__identity;User ID=SA;Password=Pass@word;TrustServerCertificate=True;"
  },
  "QuickcodeClients": {
    "QuickcodeModuleApi": "http://quickcode-module-api/",
    "IdentityModuleApi": "http://quickcode-identity-module-api/"
  },
  "EmailService": {
    "BaseUrl": "https://api.quickcode.net/",
    "SendPath": "api/Email/send-from-template",
    "ProjectKey": "quickcode",
    "PortalUrl": "http://localhost:6020",
    "ApiKey": ""
  },
  "QuickcodeApiKeys": {
    "EmailSenderModuleApiKey": ""
  },
  "GatewayServiceTokenSettings": {
    "Issuer": "quickcode-gateway",
    "ExpirationSeconds": 60
  },
  "Kafka": {
	"BootstrapServers": "kafka.quickcode.net:9092",
	"GroupId": "WorkflowGroup"
  },
  "JwtSettings": {
    "Issuer": "https://quickcode-api.quickcode.net",
    "Audience": "quickcode-client-id",
    "AccessTokenExpirationMinutes": 5,
    "RefreshTokenExpirationMinutes": 30
  },
  "CorsSettings": {
    "AllowOrigins": [ "http://localhost:3000", "http://localhost:6060", "http://quickcode-gateway-api", "https://*.quickcode.net", "https://*.europe-west1.run.app" ]
  },
  "AppSettings": {
    "ModuleName": "IdentityModule",
    "UseHealthCheck": "true",
    "DatabaseType": "mssql",
    "InMemoryDbName": "IdentityModuleDb",
    "HealthCheckSeconds": "60"
  },
  "Logging": {
    "ApiName": "quickcode-identitymodule-api",
    "ElasticConfiguration": {
      "Uri": "http://quickcode-elasticsearch:9200"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Information",
        "Microsoft": "Information"
      }
    }
  },
  "Auditing": {
    "CaptureFullEntityOnUpdate": true,
    "CaptureFullEntityOnInsert": true,
    "CaptureFullEntityOnDelete": true
  },
  "AllowedHosts": "*"
}